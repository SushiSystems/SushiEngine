#version 450
#extension GL_GOOGLE_include_directive : require

// Particle simulate (design §5.3): one thread per shared-pool slot. Advances each live particle
// by the emitter's update modules (gravity, drag, curl-noise turbulence), integrates its motion,
// ages it, applies the size/colour-over-life LUTs, retires the dead, and appends the survivors
// to this frame's compacted draw list — atomically bumping the indirect draw's instance count.
// Shares the ParticleSimPass descriptor set with particle_emit.comp.

#include "particle_common.glsl"

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) buffer Pool { Particle pool[]; };
layout(std430, set = 0, binding = 1) readonly buffer Emitters { Emitter emitters[]; };
layout(std430, set = 0, binding = 2) writeonly buffer DrawList { Particle draw[]; };
layout(std430, set = 0, binding = 3) buffer DrawArgs { uint args[]; };
layout(std430, set = 0, binding = 4) readonly buffer CurveLuts { float curve_luts[]; };
layout(std430, set = 0, binding = 5) readonly buffer GradientLuts { float gradient_luts[]; };
layout(std430, set = 0, binding = 6) writeonly buffer AlphaDrawList { Particle alpha_draw[]; };
layout(std430, set = 0, binding = 7) writeonly buffer RibbonDrawList { Particle ribbon_draw[]; };
layout(std430, set = 0, binding = 8) buffer Trail { vec4 trail[]; };
layout(std430, set = 0, binding = 9) writeonly buffer MeshDrawList { Particle mesh_draw[]; };
layout(std430, set = 0, binding = 10) buffer MeshArgs { uint mesh_args[]; };
// Last frame's linearised depth pyramid, level 0 — the collision surface. Pass-owned by HizPass and
// so still holding the previous frame when this pass runs, which is before the depth prepass.
layout(set = 0, binding = 11) uniform sampler2D depth_pyramid;
// The GI distance field, the off-screen collision surface. Its config rides its own uniform
// block rather than the push constants, which are already full.
layout(set = 0, binding = 12) uniform sampler3D sdf_clipmap;
layout(set = 0, binding = 13) uniform SdfConfigBlock { SdfClipmapConfig sdf_config; };

// Exactly 128 bytes, the house budget, shared with particle_emit.comp. The camera block is here
// only for the depth collision, which projects each particle into last frame's depth pyramid.
layout(push_constant) uniform Push
{
    mat4 view_projection;
    vec4 camera_right;  // xyz world camera right; w = tan(half horizontal fov)
    vec4 camera_up;     // xyz world camera up;    w = tan(half vertical fov)
    uvec4 counts;       // x = emitter index (emit only), y = pool capacity, z = depth pyramid usable,
                        // w = distance field usable
    vec4 misc;          // x = fixed simulation step this frame; yzw = eye position
} pc;

float sample_curve(int lut, float t)
{
    if (lut < 0)
        return 1.0;
    uint base = uint(lut) * CURVE_LUT_WIDTH;
    float x = clamp(t, 0.0, 1.0) * float(CURVE_LUT_WIDTH - 1u);
    uint i = uint(x);
    uint j = min(i + 1u, CURVE_LUT_WIDTH - 1u);
    return mix(curve_luts[base + i], curve_luts[base + j], x - float(i));
}

vec4 sample_gradient(int lut, float t)
{
    if (lut < 0)
        return vec4(1.0);
    uint base = uint(lut) * GRADIENT_LUT_WIDTH * 4u;
    float x = clamp(t, 0.0, 1.0) * float(GRADIENT_LUT_WIDTH - 1u);
    uint i = uint(x);
    uint j = min(i + 1u, GRADIENT_LUT_WIDTH - 1u);
    float f = x - float(i);
    vec4 a = vec4(gradient_luts[base + i * 4u + 0u], gradient_luts[base + i * 4u + 1u],
                  gradient_luts[base + i * 4u + 2u], gradient_luts[base + i * 4u + 3u]);
    vec4 b = vec4(gradient_luts[base + j * 4u + 0u], gradient_luts[base + j * 4u + 1u],
                  gradient_luts[base + j * 4u + 2u], gradient_luts[base + j * 4u + 3u]);
    return mix(a, b, f);
}

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.counts.y)
        return;

    Particle p = pool[i];
    if (p.life <= 0.0)
        return; // a dead slot, awaiting recycling by the emit pass

    Emitter e = emitters[p.emitter_index];
    vec3 pos = vec3(p.px, p.py, p.pz);
    vec3 vel = vec3(p.vx, p.vy, p.vz);

    vec3 accel = vec3(0.0);
    if ((e.update_flags & UPDATE_GRAVITY) != 0u)
        accel += vec3(e.gx, e.gy, e.gz);
    if ((e.update_flags & UPDATE_TURBULENCE) != 0u)
        accel += curl_noise(pos * e.turbulence_frequency) * e.turbulence_amplitude;

    float field_damp = 1.0;
    if ((e.update_flags & UPDATE_FORCE_FIELDS) != 0u)
        accel += particle_force_fields(e, pos, pc.misc.x, field_damp);

    vel += accel * pc.misc.x;
    if (field_damp < 1.0)
        vel *= max(0.0, field_damp);
    if ((e.update_flags & UPDATE_DRAG) != 0u)
        vel *= max(0.0, 1.0 - e.drag_coefficient * pc.misc.x);
    pos += vel * pc.misc.x;
    // Collide after the move, so the test sees where the particle actually got to this step.
    // Which surface it collides against is a per-emitter choice: the distance field reaches
    // off screen, the depth pyramid is sharper on what is visible. Each is gated on the host
    // having supplied it, so an emitter authored for one falls back rather than reading a
    // resource that was never bound.
    if ((e.update_flags & UPDATE_COLLISION) != 0u)
    {
        bool wants_field = (e.render_flags & RENDER_DISTANCE_FIELD_COLLISION) != 0u;
        if (wants_field && pc.counts.w != 0u)
            particle_sdf_collide(sdf_clipmap, sdf_config, e, pc.misc.yzw, pos, vel);
        else if (pc.counts.z != 0u)
            particle_depth_collide(depth_pyramid, e, pc.view_projection, pc.camera_right.xyz,
                                   pc.camera_up.xyz, pc.camera_right.w, pc.camera_up.w, pos, vel);
    }
    p.rotation += p.angular_velocity * pc.misc.x;
    p.age += pc.misc.x;

    if (p.age >= p.lifetime)
    {
        p.life = 0.0;
        pool[i] = p;
        return;
    }

    float normalized_age = p.age / p.lifetime;
    p.life = 1.0 - normalized_age;
    p.px = pos.x;
    p.py = pos.y;
    p.pz = pos.z;
    p.vx = vel.x;
    p.vy = vel.y;
    p.vz = vel.z;
    if ((e.update_flags & UPDATE_SIZE_OVER_LIFE) != 0u)
        p.size = p.birth_size * sample_curve(e.size_curve_lut, normalized_age);
    if ((e.update_flags & UPDATE_COLOR_OVER_LIFE) != 0u)
    {
        vec4 g = sample_gradient(e.color_gradient_lut, normalized_age);
        p.cr = g.r;
        p.cg = g.g;
        p.cb = g.b;
        p.alpha = g.a;
    }
    uint cells = e.flipbook_rows * e.flipbook_columns;
    if (cells > 1u)
        p.flipbook_frame = min(uint(normalized_age * float(cells)), cells - 1u);

    pool[i] = p;

    // The trail is shifted rather than kept as a ring: with the newest sample always at index 0
    // the vertex stage needs no head index, which would otherwise have to reach it through a
    // push constant the 128-byte draw block has no room for. Seven vec4 moves against a curl-noise
    // evaluation is not a cost worth that complication.
    if (e.alignment == ALIGN_RIBBON)
    {
        uint base = i * TRAIL_POINTS;
        for (uint k = TRAIL_POINTS - 1u; k > 0u; --k)
            trail[base + k] = trail[base + k - 1u];
        trail[base] = vec4(pos, p.size);
    }

    // Bucket the survivors. Geometry decides first: ribbons and beams draw as strips (draw arg
    // [8..11]) and mesh particles as indexed instances in their emitter's own slice, both of which
    // are a different draw rather than a different shader path. Everything left is a sprite and
    // splits by blend — true-alpha into the alpha list (draw arg [4..7]), additive and
    // premultiplied into the order-independent additive list (draw arg [0..3]).
    //
    // A beam shares the ribbon bucket outright: same strip expansion, same vertex count, same
    // pipeline. Only the sample source differs, and that is a branch inside the vertex stage.
    if (e.alignment == ALIGN_RIBBON || e.alignment == ALIGN_BEAM)
        ribbon_draw[atomicAdd(args[9], 1u)] = p;
    else if (e.alignment == ALIGN_MESH)
    {
        // An emitter past the last mesh slice draws nothing: sharing a slice would render its
        // particles as another emitter's mesh, which is worse than dropping them. The slice bound
        // is checked here because the indirect instance count is a GPU value the host cannot clamp.
        if (e.mesh_slot != NO_MESH_SLOT)
        {
            uint slice = e.capacity / MAX_MESH_EMITTERS;
            uint local = atomicAdd(mesh_args[e.mesh_slot * 5u + 1u], 1u);
            if (local < slice)
                mesh_draw[e.mesh_slot * slice + local] = p;
        }
    }
    else if (e.blend == BLEND_ALPHA)
        alpha_draw[atomicAdd(args[5], 1u)] = p;
    else
        draw[atomicAdd(args[1], 1u)] = p;
}
