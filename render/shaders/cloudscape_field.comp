#version 450
#extension GL_GOOGLE_include_directive : require

// Bakes the cloudscape *envelope* field (T3, reshaped by CloudsV2 —
// docs/slop/atmosphere_system.md §7.6): where cloud may exist and how much water fills it,
// once per rebake instead of once per march sample. Every consumer of the cloudscape — the
// view march, the light volume, the cloud shadow map, the far-field panorama — reads the same
// baked answer, so none of them can disagree about where the weather is.
//
// What this bake deliberately no longer does is carve the cloud's **shape**. It used to: the
// Nubis threshold, the domain warp and the detail erosion all ran here, and their result was
// stored into 128 m (near) / 1024 m (far) texels that the march then reconstructed
// trilinearly. That is a hard ceiling on how a cloud can look — a cauliflower edge lives at
// 10-50 m scales, and no amount of marching recovers structure a 128 m lattice never held;
// what reaches the screen is the smeared *average* of a shape, which is exactly the mushy
// cotton the system was rejected for. The carve now runs analytically per march sample in
// cloud.frag against the same world-anchored pattern frame, so its effective resolution is
// the march's own sample spacing rather than any bake lattice. This bake keeps everything
// that is genuinely low-frequency: the simulation's coverage, the water amplitude, the
// vertical profile, the weather-map modulation — the *envelope* the carve cuts from.
//
// Channel layout, both windows: r = coverage envelope [0, 1] (the carve threshold's input),
// g = vertical profile, b = optical depth toward the sun (far window only; see
// cloudscape_far_light.comp), a = in-cloud water amplitude, encoded at half scale
// (cloud_field_window.glsl's cloud_field_water).
//
// Two things changed here in phase B (docs/slop/atmosphere_system.md §7.2/§7.4), and they
// are the same change seen from two ends:
//
// 1. The field is no longer a periodic, camera-locked 32 km tile. It is a **camera-centred,
//    non-wrapping window** whose texels stand over known world positions, pushed in as an
//    origin and a span (see cloud_field_window.glsl for why that is what unlocks the rest).
//    Two windows are baked with this same shader: a near one at ~128 m per texel and a far
//    one covering the whole march range at ~1 km. The pattern is evaluated at a *world*
//    coordinate rather than a camera-relative one, which is also what stops the sky from
//    travelling with the camera the way the wrapped tile made it.
//
// 2. When the simulation publishes a field it classifies (`WeatherField::derives_genus`),
//    each baked column resolves **its own genus** from the local band state instead of
//    instantiating one globally compiled deck stack everywhere. That is §7.4: genus stops
//    being an input to the density field and becomes a label derived from it. A stratus
//    sheet here, a cumulus field 40 km away and a cirrus deck over both is one bake, not
//    three global decks fighting over one coverage number. The authored deck stack remains
//    the path for a manually authored sky, unchanged — a `Cloudscape` an author typed in is
//    not a classification and must not be round-tripped through the classifier.
//
// The wind is absorbed here rather than scrolled at sample time: the pattern origin the CPU
// pushes already carries however far the sky has blown, and the march offsets its lookup only
// by the residual since this bake, which is metres rather than kilometres. That is what lets
// the window be non-wrapping and still advect.

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image3D cloudscape_field;

layout(set = 0, binding = 1) uniform SceneBlock
{
    mat4 view;
    mat4 proj;
    vec4 cam_forward;
    vec4 cam_right;
    vec4 cam_up;
    vec4 planet_center;
    vec4 planet_radii;
    vec4 sun_dir;
    vec4 sun_color;
    vec4 ambient;
    vec4 rayleigh;
    vec4 scatter;
    vec4 ground_albedo;
    vec4 ocean_color;
    vec4 cloud_global;
    vec4 star_params;
    vec4 misc;
    vec4 sky_counts;
    vec4 planet_frame;
    vec4 cloud_light;
    // Declared through to the weather members: std140 offsets are positional, so reaching
    // the block's tail means naming everything before it.
    vec4 ibl_params;
    vec4 cloud_deck_a[6];
    vec4 cloud_deck_b[6];
    vec4 cloud_deck_c[6];
    vec4 cloud_deck_d[6];
    vec4 bodies[80];
    vec4 sky_stars[128];
#include "scene_weather_tail.glsl"
} scene;

// Bindings 2/3/5 (shape, detail, cirrus) are still part of this pass's descriptor layout but
// deliberately no longer sampled: the carve that read them runs per march sample in
// cloud.frag now (CloudsV2), against the precombined march volume. Declarations kept so the
// C++ side's descriptor writes stay valid without a layout change.
layout(set = 0, binding = 2) uniform sampler3D cloud_shape_texture;
layout(set = 0, binding = 3) uniform sampler3D cloud_detail_texture;
layout(set = 0, binding = 4) uniform sampler2D cloud_weather_texture;
layout(set = 0, binding = 5) uniform sampler3D cloud_cirrus_texture;
// The simulation's own horizontal grid (WeatherFieldPass): rgba = coverage / density scale
// (half-encoded) / convective fraction / precipitation, addressed in world space by
// scene.weather_field_map and in the vertical by band index. Read here and nowhere else —
// this bake is the one place the meteorology enters the render tier.
layout(set = 0, binding = 6) uniform sampler3D weather_field;

// The regional nest's optical extinction (atmosphere_extinction.comp): r = sigma in 1/m,
// g = the vertical profile through the cloud's own depth, b = rain content, a = the cell's
// cloud fraction. Read only when the nest is running, and when it is, it replaces both paths
// below.
layout(set = 0, binding = 8) uniform sampler3D nest_extinction;

// The WMO genus catalogue, uploaded once at pass construction from Render::cloud_genus_profile
// and Render::cloud_genus_thresholds. Static data, so it is a device-local block written at
// startup rather than a per-frame upload.
layout(set = 0, binding = 7) uniform GenusCatalogue
{
    vec4 a[10];       // base altitude, top altitude, default coverage, default density
    vec4 b[10];       // stratiform, detail strength, shape scale, detail scale
    vec4 c[10];       // wind.xyz, noise kind (1 = cirriform)
    vec4 d[10];       // anvil, spare, spare, spare
    // Render::CloudGenusThresholds, in field order:
    //   x = convective, y = low_broken, z = middle_overcast, w = high_sheet
    vec4 thresholds;
    //   x = cumulonimbus_convective, y = cumulonimbus_coverage, z = enable_coverage
    vec4 thresholds_tail;
} genus;

layout(push_constant) uniform Params
{
    // World XZ of this window's texel-(0,0) corner in the *pattern* frame: scene-absolute
    // metres plus everything the wind has displaced the sky by. The noise is evaluated here.
    vec2 pattern_origin;
    // The same corner in *camera-relative* metres, which is the frame scene.weather_field_map
    // addresses. The meteorology is looked up here. The two differ by the eye and the wind.
    vec2 world_origin;
    float span_meters;
    float weather_scale;   // Cloudscape::weather_scale, the coverage map's tiling period
    uint derive_genus;     // 1 = resolve a genus per column from the field; 0 = authored decks
    // Sub-texel taps per XZ axis. 1 for the near window. The far window carves at the *near*
    // window's scale and averages supersample² taps per texel — threshold first, then filter,
    // which is the order the aliasing note below names as correct — so both windows carve the
    // same clouds and the cross-fade interpolates one realisation instead of two.
    uint supersample;
    // First Z slice of this dispatch, so a supersampled bake can be spread across frames
    // instead of landing as one hitch. 0 for a whole-volume bake.
    uint slab_base;
} params;

// Deliberately not including cloud_field_window.glsl: this shader is the one consumer that
// is *told* its window rather than reading the published one, because it bakes both windows
// and the near/far selection those helpers exist for is a read-side concern.

#define CLOUD_MAX_DECKS 6

// Genus indices, matching Render::CloudGenus's declaration order. The classifier below
// mirrors Render::classify_cloud_genus branch for branch; its *thresholds* are uploaded
// rather than repeated (see the catalogue block), so retuning the classifier is a data
// change, and the two copies of the branch structure name each other so neither is edited
// alone.
const int GENUS_CIRRUS = 0;
const int GENUS_CIRROSTRATUS = 2;
const int GENUS_ALTOCUMULUS = 3;
const int GENUS_ALTOSTRATUS = 4;
const int GENUS_NIMBOSTRATUS = 5;
const int GENUS_STRATOCUMULUS = 6;
const int GENUS_STRATUS = 7;
const int GENUS_CUMULUS = 8;
const int GENUS_CUMULONIMBUS = 9;

const int BAND_COUNT = 3;

float remap(float v, float a, float b, float c, float d)
{
    return c + (v - a) / (b - a) * (d - c);
}

// The carve, its CDF-uniformisation and its Nyquist floor all lived here once; they moved
// with the shape work into cloud_noise_volume.comp (the precombined march volume, where the
// base shape is uniformised at generation) and cloud.frag (the per-sample carve, whose
// "grid" is the march's own footprint and which floors its carve scale against that footprint
// for exactly the reason the bake used to floor against its texel). What stays below is the
// envelope: coverage, water, vertical structure.

float cloud_height_gradient(float height01, float stratiform, float anvil)
{
    float cumuliform = clamp(remap(height01, 0.0, 0.15, 0.0, 1.0), 0.0, 1.0) *
                       clamp(remap(height01, 0.55, 1.0, 1.0, 0.0), 0.0, 1.0);
    float sheet = clamp(remap(height01, 0.0, 0.08, 0.0, 1.0), 0.0, 1.0) *
                  clamp(remap(height01, 0.80, 1.0, 1.0, 0.0), 0.0, 1.0);
    float tower = clamp(remap(height01, 0.0, 0.10, 0.0, 1.0), 0.0, 1.0) *
                  clamp(remap(height01, 0.90, 1.0, 1.0, 0.0), 0.0, 1.0);
    float g = mix(cumuliform, sheet, stratiform);
    return mix(g, tower, anvil);
}

// One deck's *envelope* at a world pattern position: the coverage the march's carve will
// threshold against, tapered vertically by the deck's own height gradient so the carve eats
// domes out of a deck's top instead of leaving a hard slab face. Parameterized by the deck's
// four packed vectors rather than reading the deck array directly, because the derived path
// builds them from the genus catalogue and the authored path copies them out of the scene
// block, and both have to land in exactly the same evaluation.
//
//   la = base altitude, top altitude, coverage, density scale
//   lb = stratiform, detail strength, shape scale, detail scale (shape/detail now belong to
//        the march's carve; kept in the layout so the catalogue's packing is untouched)
//   lc = wind.xyz, noise kind
//   ld = anvil, weather scale, spare, spare
//
// `slot` only decorrelates one deck's weather-map lookup from another's, so two decks sharing
// an altitude do not modulate identically. `height_gradient` is this deck's vertical profile
// at world_altitude (0 at its top/bottom edges, 1 through its middle), left at 0 wherever the
// deck contributes nothing. `water` is the deck's authored in-cloud density scale.
float deck_envelope(vec4 la, vec4 lb, vec4 lc, vec4 ld, int slot, vec2 xz, float world_altitude,
                    out float height_gradient, out float water, out float deck_height01)
{
    height_gradient = 0.0;
    water = 0.0;
    // Published so the march's erosion can tell a cloud's own base from its own top. It
    // used to key that off `cloud_shell_height`, which normalises against the union of every
    // enabled deck — 800..12 000 m in the default sky — so a cumulus spanning 1 000..3 200 m
    // sat at 0.018..0.214 of the shell and never left the base regime. See cloud.frag's
    // carve.
    deck_height01 = 0.0;
    float density_scale = la.w;
    if (density_scale <= 0.0)
        return 0.0;
    if (world_altitude < la.x || world_altitude > la.y)
        return 0.0;
    float height01 = (world_altitude - la.x) / max(la.y - la.x, 1.0);

    float stratiform = lb.x;
    float anvil = ld.x;
    float weather_scale = max(ld.y, 1.0);

    // Fixed up = +Y, so the tangent basis is just the flat XZ axes — no cross/normalize
    // needed, unlike the per-sample march which derives it from the point's own radial
    // direction on the curved planet.
    vec3 deck_offset = vec3(float(slot) * 6130.0, float(slot) * 2710.0, float(slot) * 9770.0);
    vec3 sp = vec3(xz.x, world_altitude, xz.y) + deck_offset;

    vec2 wpln = sp.xz;
    vec2 wuv = wpln / weather_scale;
    vec2 wwarp = texture(cloud_weather_texture, wuv * 0.15 + vec2(0.37)).rg - 0.5;
    wuv += wwarp * 0.9;
    float weather = texture(cloud_weather_texture, wuv).r;

    vec2 wind_dir = vec2(lc.x, lc.z);
    float wlen = length(wind_dir);
    vec2 along = wlen > 1e-3 ? wind_dir / wlen : vec2(1.0, 0.0);
    vec2 across = vec2(-along.y, along.x);
    // Cloud streets: convective rolls aligned with the shear, so the pattern is stretched
    // along the wind. Real ones are 2-8 km apart and a few times that long. This used to divide
    // by `weather_scale * 0.22` with a 4:1 stretch, which at the default 60 km weather scale
    // drew ridges 13 km across and 53 km long -- a structure with no counterpart in the sky, and
    // the other half of why a cumulus deck read as sausages.
    vec2 street_uv = vec2(dot(wpln, along) * 0.33, dot(wpln, across)) / (weather_scale * 0.083);
    float weather_small = texture(cloud_weather_texture, street_uv + vec2(0.13)).r;
    weather = weather * 0.7 + weather_small * 0.3;

    // The tiled weather map is a *detail* modulation of the deck's own coverage, at a reduced
    // amplitude — the §7.3 demotion. Where the coverage comes from is what changed: on the
    // derived path it is the simulation's own value at this column, unique over hundreds of
    // kilometres, so the tiling stops reading as tiling because the repeating thing is no
    // longer the thing deciding whether there is a cloud here.
    const float WEATHER_DETAIL_AMPLITUDE = 0.35;
    float coverage = clamp(la.z + (weather - 0.5) * WEATHER_DETAIL_AMPLITUDE, 0.0, 1.0);
    coverage = clamp(coverage + anvil * smoothstep(0.55, 1.0, height01) * 0.55, 0.0, 1.0);
    if (coverage <= 0.0)
        return 0.0;

    float hg = cloud_height_gradient(height01, stratiform, anvil);
    if (hg <= 0.0)
        return 0.0;

    height_gradient = hg;
    deck_height01 = height01;
    water = density_scale;
    // The taper multiplies the *envelope*, not the water: near the deck's own top and base
    // the carve threshold rises toward 1, so only the noise's peaks survive — turrets and
    // domes — while a sample through the deck's middle keeps the full coverage. Stratiform
    // decks taper more gently (their sheet gradient is wide), which is what keeps a stratus
    // ceiling a ceiling.
    return coverage * hg;
}

// Mirrors Render::classify_cloud_genus. See the note by the genus index constants above.
int classify_genus(int band, float coverage, float convective)
{
    if (band == 0)
    {
        if (convective > genus.thresholds.x)
            return GENUS_CUMULUS;
        if (convective > genus.thresholds.y)
            return GENUS_STRATOCUMULUS;
        return GENUS_STRATUS;
    }
    if (band == 1)
    {
        if (convective > genus.thresholds.x)
            return GENUS_ALTOCUMULUS;
        if (coverage > genus.thresholds.z)
            return GENUS_NIMBOSTRATUS;
        return GENUS_ALTOSTRATUS;
    }
    return coverage > genus.thresholds.w ? GENUS_CIRROSTRATUS : GENUS_CIRRUS;
}

// The simulated band state at this column: r = coverage, g = density scale (half-encoded on
// upload, so doubled back here), b = convective fraction, a = column precipitation.
vec4 band_state(vec2 world_rel_xz, int band)
{
    vec2 uv = world_rel_xz * scene.weather_field_map.xy + scene.weather_field_map.zw;
    vec4 s = texture(weather_field, vec3(uv, (float(band) + 0.5) / float(BAND_COUNT)));
    s.g *= 2.0;
    return s;
}

// Folds one deck's envelope into the running totals. Envelopes combine as a probabilistic
// union (`e1 + e2(1 - e1)`) rather than a sum: coverage is "how much of this cell is cloud",
// and two half-covered decks over each other cover three quarters of the sky, not all of it.
// The water amplitude keeps the *densest* contributor's value — the carve fills the union's
// area, and filling it at a summed amplitude would double-count overlap the union already
// resolved.
void fold_envelope(float envelope, float deck_water, float hg, float deck_h01, inout float total,
                   inout float water, inout float profile, inout float deck_height)
{
    total = clamp(total + envelope * (1.0 - total), 0.0, 1.0);
    if (envelope > 0.001)
    {
        water = max(water, deck_water);
        // `deck_height` comes from whichever deck also wins `profile`, so the pair a march
        // sample reads always describes one cloud rather than the vertical profile of one
        // deck and the base/top position within another.
        if (hg >= profile)
            deck_height = deck_h01;
        profile = max(profile, hg);
    }
}

// Accumulates one derived deck into the running totals, if the band carries one at all.
void add_derived_deck(int genus_index, float coverage, float density_scale, int slot,
                      vec2 pattern_xz, float world_altitude, inout float envelope,
                      inout float water, inout float profile, inout float deck_height)
{
    vec4 la = genus.a[genus_index];
    la.z = coverage;                       // the simulation's own coverage, not the genus default
    la.w = max(la.w * density_scale, 0.0); // ... scaled about the genus's own opacity
    vec4 ld = genus.d[genus_index];
    ld.y = params.weather_scale;

    float hg;
    float deck_water;
    float deck_h01;
    float e = deck_envelope(la, genus.b[genus_index], genus.c[genus_index], ld, slot, pattern_xz,
                            world_altitude, hg, deck_water, deck_h01);
    fold_envelope(e, deck_water, hg, deck_h01, envelope, water, profile, deck_height);
}

// One envelope evaluation at one world position — the whole of what used to be main()'s
// body, factored so the supersampling loop below can average it over a texel's footprint.
// `pattern_xz` is the world-anchored, wind-advected frame the weather modulation is evaluated
// in (and the frame the march's carve will evaluate its own noise in — the two must agree or
// the carve would cut shapes out of an envelope that stands somewhere else); `world_rel_xz`
// the camera-relative frame the meteorology is looked up in.
void bake_at(vec2 pattern_xz, vec2 world_rel_xz, float world_altitude,
             out float envelope, out float profile, out float water, out float deck_height)
{
    envelope = 0.0;
    water = 0.0;
    // 0 at this sample's own cloud base, 1 at its own top. Distinct from the texel's
    // shell-relative height, which says only where the sample sits in the union of every
    // deck in the sky and is therefore useless for shaping an individual cloud.
    deck_height = 0.0;
    // The tallest/thickest local contributor's own vertical profile stands in for "this
    // texel's" profile — a deck barely reaching this altitude reads near its own edge
    // (hg -> 0) and should not flatten a thicker deck's mid-band glow (hg -> 1) sharing the
    // same texel, so this keeps the max rather than an average.
    profile = 0.0;

    if (scene.atmosphere_nest_params.z > 0.5)
    {
        // ---- The nest drives the shape (docs/slop/atmosphere_system.md §7.1/§7.3) ---------
        //
        // No genus, no deck, no height gradient: the density here *is* how much water is
        // suspended here, which the nest computed by transporting moisture through a flow and
        // condensing it where a parcel actually reached saturation. That is the whole point of
        // the tier — cloud shape stops being a profile the renderer instantiates and becomes a
        // consequence of the meteorology. A cumulus has a flat base because the condensation
        // level is flat, not because `cloud_height_gradient` draws one.
        vec2 nest_uv = world_rel_xz * scene.atmosphere_nest_map.xy + scene.atmosphere_nest_map.zw;
        // The nest's levels are stretched (z = top * f^s), so the inverse is one pow: the
        // exponent is uploaded already inverted so this is not a divide in a per-texel loop.
        float nest_w = pow(clamp(world_altitude / max(scene.atmosphere_nest_params.x, 1.0),
                                 0.0, 1.0),
                           scene.atmosphere_nest_params.y);
        vec4 nest = texture(nest_extinction, vec3(nest_uv, nest_w));

        // The nest's condensate answers "how much cloud belongs here", stated against the
        // extinction of 1 g/m^3 of liquid water. It does *not* answer "what shape is it",
        // and it cannot: the nest resolves 2 km, and a fair-weather cumulus is 0.5-2 km
        // across, so at this grid one cumulus is one cell. The shape is the march's carve's
        // job now (CloudsV2); what this path publishes is the carve's two inputs, kept
        // strictly apart because they answer different questions:
        //
        //   * `envelope` — *where* cloud may exist: the nest's own diagnosed cloud fraction
        //     (how much of this cell is cloud), tapered toward the cloud's own top so the
        //     carve eats domes and turrets there instead of leaving a flat slab face.
        //   * `water` — *how much* is in it: the **in-cloud** liquid, not the cell mean.
        //     Sigma is spread over the whole cell and the water occupies only `coverage` of
        //     it, so the carve — which fills that same fraction of the sky — must be filled
        //     at sigma/coverage or a small dense cumulus is dimmed twice for being small.
        float coverage = clamp(nest.a, 0.0, 1.0);
        profile = clamp(nest.g, 0.0, 1.0);

        if (coverage > 0.0)
        {
            // How open the sky is one nest level up, and therefore whether this sample sits at
            // its cloud's own top. The deck path tapers its invented density with a height
            // gradient; this path's coverage is measured and must not be double-tapered — but
            // with no vertical shaping at all a one-level deck carves as a slab with a flat top
            // face across kilometres. Lowering the envelope where the level above is clear
            // lets the march's carve eat domes out of the top while the base — which has cloud
            // above it and is genuinely flat, because the condensation level is — stays flat.
            // The taper acts on where the cloud is, never on how much water is in it, so the
            // column's optical depth stays the nest's own.
            vec4 nest_above = texture(nest_extinction,
                                      vec3(nest_uv, min(nest_w + 0.05, 1.0)));
            float top_openness = 1.0 - clamp(nest_above.a / max(coverage, 1e-3), 0.0, 1.0);
            envelope = coverage * (1.0 - 0.45 * top_openness);

            // Where this sample sits between its own cloud's base and its own top. The nest
            // path has no deck to ask, so the cloud's extent is measured the only way it
            // exists here: from how much cloud the column carries above versus below. It
            // reads 0 with nothing below (a base) and 1 with nothing above (a top), and it
            // degrades gracefully through a deep column, which is what the march's erosion
            // needs — wispy rags at the base, packed billows at the top. One extra gather,
            // paid once per baked texel rather than once per march sample.
            vec4 nest_below = texture(nest_extinction,
                                      vec3(nest_uv, max(nest_w - 0.05, 0.0)));
            float below = clamp(nest_below.a, 0.0, 1.0);
            float above = clamp(nest_above.a, 0.0, 1.0);
            deck_height = clamp(below / max(below + above, 1e-3), 0.0, 1.0);

            // The floor bounds the divide for a cell with a sliver of cloud in it; below a
            // twentieth of a cell there is nothing here to see at this grid anyway.
            water = clamp(nest.r / (max(coverage, 0.05) *
                                    max(scene.atmosphere_nest_params.w, 1e-6)),
                          0.0, 1.0);
        }
    }
    else if (params.derive_genus != 0u && scene.weather_field_levels.w > 0.5)
    {
        float enable = genus.thresholds_tail.z;
        for (int band = 0; band < BAND_COUNT; ++band)
        {
            vec4 state = band_state(world_rel_xz, band);
            if (state.r <= enable)
                continue;
            // Cloud-base darkening: the low band is the one the moisture closure actually
            // rains from, so it is the only one a surface shower thickens. Same rule
            // WeatherCloudscapeCompiler applies on the label side, so the reported deck and
            // the rendered one describe the same cloud.
            float density_scale = band == 0 ? clamp(state.g * (1.0 + state.a), 0.0, 2.0) : state.g;
            add_derived_deck(classify_genus(band, state.r, state.b), state.r, density_scale, band,
                             pattern_xz, world_altitude, envelope, water, profile, deck_height);
        }

        // Deep convection is an extra deck on the low band rather than a replacement for it,
        // which is how a cumulus field with one storm growing out of it stays representable —
        // Render::cloud_band_towers states the same rule for the label side.
        vec4 low = band_state(world_rel_xz, 0);
        if (low.b > genus.thresholds_tail.x && low.r > genus.thresholds_tail.y)
        {
            add_derived_deck(GENUS_CUMULONIMBUS, low.r, clamp(low.g * low.b, 0.0, 2.0),
                             BAND_COUNT, pattern_xz, world_altitude, envelope, water, profile,
                             deck_height);
        }
    }
    else
    {
        // The authored deck stack, evaluated globally. Reached for a manually authored sky,
        // for `StaticWeather`, and whenever no field was published at all.
        for (int i = 0; i < CLOUD_MAX_DECKS; ++i)
        {
            vec4 ld = scene.cloud_deck_d[i];
            ld.y = params.weather_scale;
            float hg;
            float deck_water;
            float deck_h01;
            float e = deck_envelope(scene.cloud_deck_a[i], scene.cloud_deck_b[i],
                                    scene.cloud_deck_c[i], ld, i, pattern_xz, world_altitude,
                                    hg, deck_water, deck_h01);
            fold_envelope(e, deck_water, hg, deck_h01, envelope, water, profile, deck_height);
        }
    }
}

void main()
{
    ivec3 size = imageSize(cloudscape_field);
    uvec3 texel = gl_GlobalInvocationID + uvec3(0u, 0u, params.slab_base);
    if (any(greaterThanEqual(texel, uvec3(size))))
        return;

    float height01 = (float(texel.y) + 0.5) / float(max(size.y, 1));
    float world_altitude = mix(scene.cloud_global.y, scene.cloud_global.z, height01);

    // The envelope is band-limited (no threshold happens here any more — the carve moved to
    // the march), so a texel's mean over a few taps is an honest reconstruction; the
    // supersampling that once existed to anti-alias the carve now only smooths the weather
    // map's own finest modulation across a coarse far-window texel.
    uint taps = max(params.supersample, 1u);
    float envelope = 0.0;
    float profile = 0.0;
    float water = 0.0;
    float deck_height = 0.0;
    for (uint sz = 0u; sz < taps; ++sz)
        for (uint sx = 0u; sx < taps; ++sx)
        {
            vec2 uv01 = (vec2(texel.xz) + (vec2(sx, sz) + 0.5) / float(taps)) / vec2(size.xz);
            vec2 pattern_xz = params.pattern_origin + uv01 * params.span_meters;
            vec2 world_rel_xz = params.world_origin + uv01 * params.span_meters;
            float tap_envelope;
            float tap_profile;
            float tap_water;
            float tap_deck_height;
            bake_at(pattern_xz, world_rel_xz, world_altitude, tap_envelope, tap_profile,
                    tap_water, tap_deck_height);
            envelope += tap_envelope;
            profile += tap_profile;
            water += tap_water;
            deck_height += tap_deck_height;
        }
    float weight = 1.0 / float(taps * taps);
    envelope *= weight;
    profile *= weight;
    water *= weight;
    deck_height *= weight;

    // b is written twice, by two writers that never overlap. In the *far* window it is the
    // optical depth toward the sun, which only cloudscape_far_light.comp can fill (it needs
    // the finished envelope field to march) and which overwrites what is stored here. In the
    // *near* window nothing overwrites it, and the march reads the real light volume for its
    // sun depth instead — so the lane is free there, and it now carries the within-cloud
    // height the carve's erosion needs. The two uses are co-sited with the carve's own detail
    // fade: the erosion is fully faded out by 14 km (cloud.frag's DETAIL_FADE_START_METERS)
    // and the near window hands over to the far one at ~13.8 km, so no sample ever needs the
    // near meaning from a far texel. cloud_field_window.glsl states the same rule for readers.
    // a is the in-cloud water amplitude at half scale (cloud_field_window.glsl's
    // cloud_field_water decodes it), so an authored density_scale up to 2 survives UNORM.
    imageStore(cloudscape_field, ivec3(texel),
              vec4(clamp(envelope, 0.0, 1.0), clamp(profile, 0.0, 1.0),
                   clamp(deck_height, 0.0, 1.0), clamp(water * 0.5, 0.0, 1.0)));
}
