#version 450
#extension GL_GOOGLE_include_directive : require

// Kessler (1969) warm-rain microphysics with saturation adjustment and latent heating: the
// closed cycle vapour -> cloud -> rain -> evaporation that turns a moist updraft into a visible
// cloud that eventually rains itself out.
//
// docs/slop/atmosphere_system.md §6. Every step below replaces something the shipped system
// did with a threshold (§1.3's table, line for line):
//
//   | what meteorology requires            | what the shipped code did      |
//   | saturation vapour pressure           | `if (humidity > 0.85)`         |
//   | mixing ratio q_v [kg/kg]             | dimensionless humidity [0,1.3] |
//   | latent heating on condensation       | none                           |
//   | warm-rain microphysics               | `if (cloud_water > 0.5)`       |
//
// The one that changes the *look* of the sky most is latent heating. Condensation releases
// 2.5 MJ per kilogram of water, which warms the parcel, which makes it more buoyant, which
// makes it rise faster and lift more vapour to its condensation level. Without that term a
// cloud is a passive marker of where moist air happened to be; with it, a cloud is an engine,
// and that is the difference between a cumulus that sits there and one that grows a tower.
//
// Cloud *base* falls out rather than being placed: a parcel rising along its dry adiabat cools
// until q_s(T) drops to its own q_v, and the altitude where that happens is the lifting
// condensation level. Nothing in this shader knows what altitude that is.
//
// The saturation adjustment carries a **subgrid cloud fraction** on top of Kessler, and that is
// not an embellishment: at 2 km spacing the cell mean and the parcel are different things, and
// condensing only on the mean is what made this nest produce fog at 19 m and never a cumulus.
// `nest_cloud_partition` in atmosphere_nest_common.glsl holds the closure and the measurement.

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

#include "atmosphere_nest_common.glsl"

layout(set = 0, binding = 1, r32f) uniform image3D theta;
layout(set = 0, binding = 2, rgba32f) uniform image3D moisture;
// Surface precipitation accumulated out of the bottom of the column, mm/h — what the world
// coupling, the rain emitter and the readback all ultimately read.
layout(set = 0, binding = 3, r32f) uniform image2D surface_rain;

void main()
{
    ivec3 cell = ivec3(gl_GlobalInvocationID);
    int levels = nest_level_count();
    if (cell.x >= nest.cells_x || cell.y >= levels || cell.z >= nest.cells_z)
        return;

    float altitude = nest_level_altitude(float(cell.y));
    float thickness = nest_level_thickness(cell.y);
    float exner = nest_exner(altitude);
    float pressure = nest_base_pressure(altitude);
    float density = nest_base_density(altitude);
    float base_theta = nest_base_theta(altitude);
    float dt = nest.dt;

    float theta_perturbation = imageLoad(theta, cell).r;
    // The three mixing ratios; the fourth channel is this shader's own output and is diagnosed
    // below rather than read, so it is deliberately not taken here.
    vec3 q = imageLoad(moisture, cell).xyz / MOISTURE_UNIT;
    float vapour = q.x;
    float cloud = q.y;
    float rain = q.z;

    // ---- Saturation adjustment, with a subgrid cloud fraction -------------------------
    //
    // Condense (or evaporate) toward the equilibrium the cell's *distribution* of humidity
    // implies, releasing (or absorbing) latent heat as it goes. Two things make this more than
    // a subtraction, and the second is the whole of this phase's fix:
    //
    //   * Saturation moves *with* the temperature the heating changes, so the adjustment is a
    //     fixed point. One Newton step on f(dq) = (q_v - dq) - q_s(T + L dq / c_p) is enough at
    //     these time steps; `nest_condensation_efficiency` is that step's denominator.
    //   * A cell is 2 km across, so its humidity is a *mean*, and a cumulus is saturated air
    //     occupying a fraction of it. `nest_cloud_partition` condenses the saturated part of
    //     that distribution rather than waiting for the mean to cross -- see its comment for
    //     why waiting produces fog and nothing else.
    //
    // Stated on the pair (total water, liquid-water temperature), which are what a parcel
    // conserves as it condenses. That is what turns the partition into a *diagnosis* of the end
    // state instead of a rate applied to whatever the last step happened to leave behind, and it
    // is what makes evaporation fall out for free: less cloud than the partition asks for
    // condenses, more evaporates, and neither needs a branch or a clamp against the cloud that
    // is there.
    // **Phase.** Everything about ice in this shader comes off `nest_ice_fraction`, a ramp on
    // temperature across the mixed-phase band -- the latent heat released, the saturation
    // condensed against, how readily the cell precipitates, and how fast that precipitation
    // falls. A diagnostic partition rather than a second prognostic species; see
    // AtmosphereParameters::latent_heat_fusion for the trade and what it gives up.
    float temperature = (base_theta + theta_perturbation) * exner;
    float ice_fraction = nest_ice_fraction(temperature);
    float latent_over_cp = nest_latent_heat(temperature) / nest.specific_heat_pressure;
    float total_water = vapour + cloud;
    // What this cell would cool to if all its condensate evaporated (or sublimed). Conserved
    // under condensation, which is exactly why the partition is evaluated against it and not
    // against T.
    float liquid_temperature = temperature - latent_over_cp * cloud;

    // Against the *blended* curve. Below freezing the ice curve sits well under the liquid one,
    // so a cell that would be clear at +2 C condenses on the same water at -25 C -- and it is
    // that gap, not a new species, that makes cold cloud form where warm cloud would not.
    float saturation = nest_saturation_mixing_ratio_phase(liquid_temperature, pressure);
    float efficiency = nest_condensation_efficiency(saturation, liquid_temperature);

    float fraction = 0.0;
    float condensate = nest_cloud_partition(total_water, saturation, efficiency, fraction);

    float excess = condensate - cloud;
    vapour = max(total_water - condensate, 0.0);
    cloud = max(condensate, 0.0);
    theta_perturbation += latent_over_cp * excess / max(exner, 1e-6);

    // The state the terms below see is the adjusted one: precipitation falls through the air
    // this cell now holds, not the air it held before condensing. The phase is re-read with it,
    // because latent heating can carry a cell back across the freezing point it condensed on the
    // cold side of.
    temperature = (base_theta + theta_perturbation) * exner;
    ice_fraction = nest_ice_fraction(temperature);
    latent_over_cp = nest_latent_heat(temperature) / nest.specific_heat_pressure;
    saturation = nest_saturation_mixing_ratio_phase(temperature, pressure);

    // ---- Autoconversion: cloud droplets collide into drizzle --------------------------
    //
    // Nothing happens below the threshold, which is what keeps a thin fair-weather cumulus
    // from raining. Above it the conversion is linear in the excess.
    //
    // The threshold falls as the cell glaciates. Ice crystals stick to each other where droplets
    // have to coalesce, and they grow by deposition at the expense of any liquid beside them --
    // so a cold cloud starts precipitating at a fraction of the condensate a warm one needs,
    // which is why a winter deck snows out of cloud that in summer would just sit there. This is
    // the Bergeron process's *consequence*; its rate is what the diagnostic partition gives up.
    float threshold = nest.autoconversion_threshold *
                      mix(1.0, nest.glaciated_autoconversion_factor, ice_fraction);
    float autoconversion = nest.autoconversion_rate * max(cloud - threshold, 0.0);

    // ---- Accretion: falling rain sweeps up the cloud droplets it passes ---------------
    //
    // The dominant rain-production term once any rain exists at all, which is why a shower
    // intensifies so much faster than it started.
    float accretion = nest.accretion_rate * cloud * pow(max(rain, 0.0), nest.accretion_exponent);

    float converted = min((autoconversion + accretion) * dt, cloud);
    cloud -= converted;
    rain += converted;

    // ---- Rain evaporation below cloud base -------------------------------------------
    //
    // Rain falling through unsaturated air evaporates, cooling it. That cooling is what makes
    // a downdraft: air that is colder than its surroundings sinks, spreads out at the ground
    // as a cold pool, and lifts the air ahead of it -- which is how one cell triggers the
    // next. This term is the entire mechanism behind the phase's acceptance bar.
    //
    // Only the *clear* part of the cell evaporates rain, which is what the cloud fraction is
    // for on this side of the scheme: inside a cloud the air is already saturated by
    // construction, so rain falling through it is not evaporating however subsaturated the cell
    // mean around it reads. Without the factor a shower would erode itself inside its own
    // parent cloud, and an overcast cell would evaporate as freely as a clear one.
    float clear = clamp(1.0 - fraction, 0.0, 1.0);
    float subsaturation = max(saturation - vapour, 0.0) * clear;
    if (rain > 0.0 && subsaturation > 0.0)
    {
        float evaporated = min(nest.rain_evaporation_rate * subsaturation *
                                   sqrt(max(rain, 0.0)) * dt,
                               min(rain, subsaturation));
        rain -= evaporated;
        vapour += evaporated;
        theta_perturbation -= latent_over_cp * evaporated / max(exner, 1e-6);
    }

    // ---- Sedimentation: rain falls ----------------------------------------------------
    //
    // Terminal fall speed after Kessler, V = a (rho q_r)^b, applied as an upwind flux from the
    // level above. Explicit and therefore limited to one level per step, which the time step
    // comfortably satisfies: at 5 m/s and a 2 s step, rain falls 10 m against level thicknesses
    // of 80 m and up.
    //
    // **Snow falls at a seventh of rain's speed**, and blending the two by the ice fraction is
    // what makes that visible without a second species. A crystal aggregate carries an enormous
    // cross-section for its mass, so it drifts at around a metre a second where a raindrop of
    // the same water falls at seven -- which is why a snow shaft leans so far downwind, and why
    // snow accumulates aloft into a deep deck where rain would have already fallen out of it.
    //
    // Melting needs no term: a snowflake falling into air above freezing arrives in a cell whose
    // ice fraction is zero, so it falls at rain's speed and evaporates on rain's curve from that
    // level down. That is the diagnostic partition doing the work a prognostic species would
    // need an explicit melting rate for -- and it is also its limit, since the melting is
    // instantaneous rather than taking the few hundred metres it really does.
    float fall_here = mix(nest.fall_speed_coefficient, nest.snow_fall_speed_coefficient,
                          ice_fraction) *
                      pow(max(density * rain, 0.0),
                          mix(nest.fall_speed_exponent, nest.snow_fall_speed_exponent,
                              ice_fraction));
    float outflow = min(fall_here * dt / thickness, 1.0) * rain;

    float inflow = 0.0;
    if (cell.y < levels - 1)
    {
        ivec3 above = ivec3(cell.x, cell.y + 1, cell.z);
        float rain_above = imageLoad(moisture, above).z / MOISTURE_UNIT;
        float thickness_above = nest_level_thickness(cell.y + 1);
        float altitude_above = nest_level_altitude(float(cell.y) + 1.0);
        float density_above = nest_base_density(altitude_above);
        // The level above falls at *its own* phase's speed, which is the point: the flux across
        // a boundary is set by what is falling, not by what it is falling into.
        float theta_above = imageLoad(theta, above).r;
        // T_base + theta' * Pi rather than (theta_base + theta') * Pi: the same number, one
        // Exner instead of two, and Exner is a pow() chain.
        float temperature_above = nest_base_temperature(altitude_above) +
                                  theta_above * nest_exner(altitude_above);
        float ice_above = nest_ice_fraction(temperature_above);
        float fall_above = mix(nest.fall_speed_coefficient, nest.snow_fall_speed_coefficient,
                               ice_above) *
                           pow(max(density_above * rain_above, 0.0),
                               mix(nest.fall_speed_exponent, nest.snow_fall_speed_exponent,
                                   ice_above));
        // Mass, not mixing ratio, is what is conserved across a level boundary, so the flux
        // carries the ratio of the two levels' air masses with it.
        float mass_ratio = (density_above * thickness_above) / max(density * thickness, 1e-6);
        inflow = min(fall_above * dt / thickness_above, 1.0) * rain_above * mass_ratio;
    }
    rain = max(rain - outflow + inflow, 0.0);

    // What leaves the lowest level has reached the ground. Converted from a mixing-ratio flux
    // to the millimetres per hour every consumer downstream speaks in: kg/m^2 of water is a
    // millimetre of depth by definition, so the mass flux *is* the rate.
    if (cell.y == 0)
    {
        float mass_flux = outflow * density * thickness / max(dt, 1e-4); // kg/(m^2 s)
        imageStore(surface_rain, ivec2(cell.x, cell.z),
                   vec4(mass_flux * 3600.0, 0.0, 0.0, 0.0));
    }

    imageStore(theta, cell, vec4(theta_perturbation, 0.0, 0.0, 0.0));
    // The fourth channel rides beside the water it describes and is *not* scaled by
    // MOISTURE_UNIT: it is a fraction, not a mixing ratio. Written unconditionally, so a cell
    // that has just cleared reports zero rather than keeping a fraction advected in from a
    // neighbour last step.
    imageStore(moisture, cell,
               vec4(vec3(max(vapour, 0.0), max(cloud, 0.0), max(rain, 0.0)) * MOISTURE_UNIT,
                    clamp(fraction, 0.0, 1.0)));
}
