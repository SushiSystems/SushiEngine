# Doxygen configuration for the SushiEngine public API reference.
#
# Scope is the public engine surface (every module's include/), the product's
# documented face. The layered design is described in docs/architecture/.
# Build it with `se doxygen` (or `doxygen Doxyfile`); output lands in
# docs/api-site/html.

PROJECT_NAME           = "SushiEngine"
PROJECT_BRIEF          = "Header-only ECS + physics engine — C++ API reference"
PROJECT_NUMBER         = "v0.1.0 (unreleased)"

OUTPUT_DIRECTORY       = docs/api-site
HTML_OUTPUT            = html
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO

# Public engine surface plus the hand-written manual landing page, the architecture
# chapters and every module's own README. The reference and the manual build together,
# Unity-manual style. Each of those markdown files carries an explicit `{#label}` on its
# title, because Doxygen derives a page identifier from the file name and twenty-odd files
# named README.md would otherwise all claim the same one.
INPUT                  = docs/api/mainpage.md \
                         docs/architecture \
                         engine
FILE_PATTERNS          = *.hpp *.h *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = docs/api/mainpage.md

# Keep internal plumbing out of the reference. A module's source/ is its
# implementation, so only the include/ trees under engine/ reach the site.
EXCLUDE_PATTERNS       = */detail/* */source/*
EXCLUDE_SYMBOLS        = *::Detail *::Detail::*

# Document the API as written; do not invent docs for undocumented symbols, and
# surface anything public that is missing one so the site stays honest.
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = docs/api-site/doxygen-warnings.log

JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
SORT_MEMBER_DOCS       = YES
ALPHABETICAL_INDEX     = YES
SOURCE_BROWSER         = NO
QUIET                  = YES
