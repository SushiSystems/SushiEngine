build/
build-editor/
build-player/
*.log

# Editor runtime layout, written next to the working dir on exit.
imgui.ini

# Disk-backed pipeline cache blob, written next to the working dir at runtime.
sushi_pipeline_cache.bin

# Generated Doxygen output.
docs/api-site/

# CLI: machine-specific overrides, Python caches, and editable installs.
cli/config.local.toml
__pycache__/
*.pyc
cli/build/
cli/*.egg-info/
.sushi_env.json

# Animation clip files
*.sushianim

# Downloaded HRTF datasets (large binaries; the SOFA demo bakes a synthetic fallback)
assets/hrtf/*.sofa

# Baked planetary terrain (17 MB for the compact lunar tier, hundreds for the deeper
# ones; reproduces from `se planet bake`, see assets/planet/README.md)
assets/planet/*.planet
