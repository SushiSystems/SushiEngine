# One tree per configure lane: build/{default,editor,player,native}. The two
# flat names are the shape the CLI used before those lanes existed, kept ignored
# so an existing checkout's trees do not surface as untracked.
build/
build-editor/
build-player/
*.log

# Cooked physics assets, written relative to the editor's working directory.
/cooked/

# Dear ImGui's own default layout file. The editor pins io.IniFilename to the
# per-user config directory instead, so this only appears if something forgets to.
imgui.ini

# Disk-backed pipeline cache blob, written next to the working dir at runtime.
sushi_pipeline_cache.bin

# Generated Doxygen output.
docs/api-site/

# CLI: machine-specific overrides, Python caches, and editable installs.
cli/config.local.toml
__pycache__/
*.pyc
cli/build/
cli/*.egg-info/
.sushi_env.json

# Animation clip files
*.sushianim

# Downloaded HRTF datasets (large binaries; the SOFA demo bakes a synthetic fallback)
assets/hrtf/*.sofa

# Baked planetary terrain (17 MB for the compact lunar tier, hundreds for the deeper
# ones; reproduces from `se planet bake`, see assets/planet/README.md)
assets/planet/*.planet

# Scratch git worktrees for isolated feature work.
.worktrees/

# Scratch ledger/briefs/reports for subagent-driven-development plan execution.
.superpowers/
