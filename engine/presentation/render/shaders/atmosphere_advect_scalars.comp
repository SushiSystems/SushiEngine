#version 450
#extension GL_GOOGLE_include_directive : require

// Transports the nest's cell-centred scalars — potential temperature and the three moisture
// species — along the flow, with a MacCormack-corrected semi-Lagrangian scheme at Courant ~ 1.
//
// docs/slop/atmosphere_system.md §1.4 is why this shader exists in this form. The shipped
// scheme ran plain bilinear semi-Lagrangian at Courant ~ 0.02 (15.6 km cells, a 15 s tick, 20
// m/s wind: a departure point moved 0.019 of a cell), which is that interpolation's
// *maximally diffusive* regime — every tick blended ~98 % of a cell with ~2 % of its
// neighbour, 240 times per simulated hour, so any sharp gradient, which is to say any front,
// smeared into gradient-free mush within simulated hours. Two changes fix it, and the design
// doc names both:
//
//   * **Courant ~ 1.** The step is chosen on the CPU from the flow's own speed, so a
//     departure point lands near a neighbouring cell centre and the interpolation barely
//     averages at all.
//   * **MacCormack.** One backward trace, one forward trace from where it landed, and the
//     round-trip error subtracted off — second-order accurate instead of first, at the cost of
//     one extra interpolation. The correction is then clamped to the interpolation stencil's
//     own min/max, which is what keeps it monotone: an overshoot cannot invent condensate that
//     was never anywhere upstream, and a mixing ratio cannot go negative.

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

#include "atmosphere_nest_common.glsl"

layout(set = 0, binding = 1) uniform sampler3D wind_x;
layout(set = 0, binding = 2) uniform sampler3D wind_y;
layout(set = 0, binding = 3) uniform sampler3D wind_z;
layout(set = 0, binding = 4) uniform sampler3D theta_source;
layout(set = 0, binding = 5) uniform sampler3D moisture_source;
layout(set = 0, binding = 6, r32f) uniform writeonly image3D theta_target;
layout(set = 0, binding = 7, rgba32f) uniform writeonly image3D moisture_target;

// Cell-centre texture coordinate for a cell index, in [0, 1] per axis. The sampler clamps, so
// a trace that leaves the domain reads the boundary cell — which is where the Davies zone has
// already nudged the solution toward the parent, so it is the right thing to read.
vec3 nest_uvw(vec3 cell)
{
    return (cell + vec3(0.5)) / vec3(float(nest.cells_x), float(nest_level_count()),
                                     float(nest.cells_z));
}

// The face-staggered wind interpolated to a cell centre, in *cell* units per second, so the
// trace below is a plain subtraction in index space. The vertical divides by the local level
// thickness because the vertical grid is stretched.
vec3 nest_velocity_cells(vec3 cell)
{
    vec3 uvw = nest_uvw(cell);
    // Each component's own face offset: u sits half a cell to the low side in x, and so on, so
    // a centre value is the average of the two faces the cell owns. Sampling at the centre of
    // a face-indexed image does exactly that average through the hardware filter.
    float u = texture(wind_x, uvw).r;
    float w = texture(wind_y, uvw).r;
    float v = texture(wind_z, uvw).r;

    int level = int(clamp(cell.y, 0.0, float(nest_level_count() - 1)));
    return vec3(u / nest.spacing, w / nest_level_thickness(level), v / nest.spacing);
}

vec4 sample_moisture(vec3 cell) { return texture(moisture_source, nest_uvw(cell)); }
float sample_theta(vec3 cell) { return texture(theta_source, nest_uvw(cell)).r; }

// Total potential temperature at a cell — the base state plus the stored perturbation. The
// mixed layer is a property of the total, not of the departure from a reference profile that
// is itself stably stratified.
float total_theta(ivec3 cell)
{
    return nest_base_theta(nest_level_altitude(float(cell.y))) +
           texelFetch(theta_source, cell, 0).r;
}

// Is @p level inside this column's mixed layer? The parcel method, which is how a bulk boundary
// layer is diagnosed: walk up from the surface and stop at the first level whose potential
// temperature exceeds the surface parcel's by more than a small excess. Below that the column
// is unstable to a surface parcel and turbulence carries it; above, the stratification holds.
//
// Diagnosed rather than prescribed because the *growth* is the whole diurnal story. At sunrise
// the profile is stable everywhere, so the layer is a few tens of metres deep and the surface
// flux moistens a shallow slab; as the ground warms, the surface parcel outgrows more of the
// column, and the layer deepens through the morning while carrying its moisture with it. A
// fixed depth mixes the full column from the first step instead, which dilutes the surface
// moisture into ten times the air it should have and puts saturation permanently out of reach.
//
// `boundary_layer_depth` survives as the *cap* — the capping inversion the free troposphere
// puts on how far a fair-weather layer can grow.
const float MIXED_LAYER_PARCEL_EXCESS = 0.5; // K

// The floor under the parcel diagnosis: the surface layer, which is never absent.
//
// The parcel test asks whether the column is unstable to a surface parcel, and a column whose
// lowest level is *colder* than the one above it is not — so it diagnoses zero depth, and a
// level that mixes with nothing accumulates whatever is added to it without limit. That is a
// trap and not merely a quiet case: the thermal seed is a random walk, so one cold excursion
// decouples the level, and the decoupled level then walks freely. Measured at -8.76 K after four
// hours, at 99 % relative humidity while the level above it sat at 50 % — the only cloud the
// subgrid closure ever got to make, and it was fog.
//
// Mechanical turbulence generated by flow over the ground does not switch off with the
// stratification, which is why every boundary-layer scheme keeps a non-zero surface exchange in
// stable conditions. Two levels — about 150 m at this stretch — is enough that the
// ground-adjacent level always exchanges with the one above it, and shallow enough that a
// genuinely stable night stays stable.
float surface_layer_depth()
{
    return min(nest_face_altitude(2.0), nest.boundary_layer_depth);
}

float mixed_layer_depth(ivec3 cell)
{
    // Cells the layer cannot reach answer without walking anything, which is most of the
    // domain: the cap is a couple of kilometres of an eighteen-kilometre column. A cap of zero
    // is how mixing is switched off entirely, and this is the branch that honours it.
    if (nest_face_altitude(float(cell.y)) >= nest.boundary_layer_depth)
        return 0.0;

    float surface_theta = total_theta(ivec3(cell.x, 0, cell.z)) + MIXED_LAYER_PARCEL_EXCESS;
    int levels = nest_level_count();
    float depth = 0.0;
    for (int k = 1; k < levels; ++k)
    {
        float top = nest_face_altitude(float(k));
        if (top > nest.boundary_layer_depth)
            return nest.boundary_layer_depth;
        depth = top;
        if (total_theta(ivec3(cell.x, k, cell.z)) > surface_theta)
            break;
    }
    return max(depth, surface_layer_depth());
}

// Traces from `cell` for `dt` cell-seconds, mid-point corrected: the velocity is re-read half
// a step back, so the path follows the flow's curvature instead of its instantaneous tangent.
vec3 trace(vec3 cell, float dt_cells)
{
    vec3 half_back = cell - nest_velocity_cells(cell) * (dt_cells * 0.5);
    return cell - nest_velocity_cells(half_back) * dt_cells;
}

void main()
{
    ivec3 cell = ivec3(gl_GlobalInvocationID);
    if (cell.x >= nest.cells_x || cell.y >= nest_level_count() || cell.z >= nest.cells_z)
        return;

    vec3 centre = vec3(cell);
    vec3 departure = trace(centre, nest.dt);

    float theta_back = sample_theta(departure);
    vec4 moisture_back = sample_moisture(departure);

    // MacCormack: trace *forward* from where the backward trace landed. Where the two agree
    // the scheme was exact; where they do not, half the round-trip error is this step's own
    // interpolation error, and subtracting it recovers second order.
    // `trace` steps backward by construction, so a negative duration is the forward trace.
    vec3 arrival = trace(departure, -nest.dt);
    float theta_round = sample_theta(arrival);
    vec4 moisture_round = sample_moisture(arrival);

    float theta = theta_back + 0.5 * (sample_theta(centre) - theta_round);
    vec4 moisture = moisture_back + 0.5 * (sample_moisture(centre) - moisture_round);

    // Monotone limiter. The correction is only trusted inside the range the backward trace's
    // own stencil actually spans: outside it the "correction" would be inventing an extremum
    // that exists nowhere upstream, which is how an unlimited MacCormack scheme manufactures
    // negative mixing ratios and spurious cold pools.
    ivec3 base = ivec3(floor(departure));
    float theta_lo = 1e30, theta_hi = -1e30;
    vec4 moist_lo = vec4(1e30), moist_hi = vec4(-1e30);
    for (int dz = 0; dz <= 1; ++dz)
        for (int dy = 0; dy <= 1; ++dy)
            for (int dx = 0; dx <= 1; ++dx)
            {
                ivec3 c = nest_clamp(base + ivec3(dx, dy, dz));
                float t = texelFetch(theta_source, c, 0).r;
                vec4 m = texelFetch(moisture_source, c, 0);
                theta_lo = min(theta_lo, t); theta_hi = max(theta_hi, t);
                moist_lo = min(moist_lo, m); moist_hi = max(moist_hi, m);
            }

    theta = clamp(theta, theta_lo, theta_hi);
    moisture = clamp(moisture, moist_lo, moist_hi);

    // The base-state transport term, and why only theta gets one.
    //
    // The moisture channels hold *totals*, so tracing them along the flow is the whole of
    // their advection: dq/dt = 0 following a parcel. `theta` holds a perturbation about a base
    // state that varies with height, and for a perturbation the material derivative is not the
    // whole equation —
    //
    //     dtheta'/dt + w * dtheta_base/dz = 0
    //
    // The second term is the stratification, and it is the term that decides whether this model
    // has any. Without it a parcel carries its warmth upward into an environment whose own
    // warming with height it never feels, so it never loses buoyancy and never finds a level
    // where it stops: convection has no equilibrium level, gravity waves have no restoring
    // force, and the Brunt-Vaisala frequency of the whole domain is zero. Applied after the
    // limiter deliberately — it is a source, not a transported quantity, and clamping it to the
    // upstream stencil would cap exactly the stable stratification it exists to supply.
    {
        float w_centre = texture(wind_y, nest_uvw(centre)).r;
        float lower = nest_level_altitude(max(float(cell.y) - 1.0, 0.0));
        float upper = nest_level_altitude(min(float(cell.y) + 1.0,
                                              float(nest_level_count() - 1)));
        float gradient = (nest_base_theta(upper) - nest_base_theta(lower)) /
                         max(upper - lower, 1.0);
        theta -= w_centre * gradient * nest.dt;
    }
    // ---- Boundary-layer vertical mixing ------------------------------------------------
    //
    // The transport that carries surface heat and moisture up out of the lowest level. It is
    // here, in the one stage that is properly double-buffered, rather than beside the
    // horizontal diffusion in `atmosphere_forces.comp`: that shader reads its neighbours from
    // the same image it writes, so its stencil sees an undefined mix of this step's and last
    // step's values. Horizontally that is a smoothing operator either way. Vertically, across a
    // surface-to-air gradient that can reach tens of kelvin over one interface, it would not be.
    //
    // Written in flux form, `dphi/dt = (F_up - F_down) / dz_k` with `F = K dphi/dz` evaluated on
    // the faces, because the vertical grid is stretched: a plain second difference would not
    // conserve, and the level thicknesses here differ by a factor of ten between the ground and
    // the domain top.
    //
    // **Potential temperature is mixed as a total, not as a perturbation.** The base state is
    // stably stratified — the ISA lapse rate is 6.5 K/km against the dry adiabat's 9.8, so
    // theta_base rises with height — and it is exactly that stratification a mixed layer has to
    // erode to become well mixed. Diffusing the perturbation alone would leave theta_base
    // untouched and could never produce a mixed layer at all.
    {
        int levels = nest_level_count();
        float thickness = nest_level_thickness(cell.y);
        float altitude = nest_level_altitude(float(cell.y));
        float lower_face = nest_face_altitude(float(cell.y));
        float upper_face = nest_face_altitude(float(cell.y) + 1.0);

        // One diagnosis serves both faces. The ground itself is never "inside": nothing crosses
        // it, so the surface level mixes only upward — which is the whole point of the term.
        float depth = mixed_layer_depth(cell);
        bool lower_inside = cell.y > 0 && lower_face < depth;
        bool upper_inside = upper_face < depth;

        if (lower_inside || upper_inside)
        {
            float theta_total = nest_base_theta(altitude) + theta;
            float delta_theta = 0.0;
            vec4 delta_moisture = vec4(0.0);

            // The lower face. Nothing crosses the ground: the surface flux is a source applied
            // in `atmosphere_forces.comp`, not something this term may transport through as well.
            if (lower_inside)
            {
                ivec3 below = ivec3(cell.x, cell.y - 1, cell.z);
                float spacing = max(altitude - nest_level_altitude(float(cell.y) - 1.0), 1.0);
                // Explicit, so the diffusion number is bounded rather than trusted. The authored
                // values leave it near 0.04 at this tier; the clamp is what keeps a coarser grid
                // or a more energetic layer from turning stability into a tuning question. Two
                // faces at 0.25 each stay inside the 0.5 an explicit scheme allows.
                float coefficient = min(nest_face_diffusivity(lower_face, depth) * nest.dt /
                                            (spacing * thickness),
                                        0.25);
                delta_theta += coefficient * (total_theta(below) - theta_total);
                delta_moisture += coefficient *
                                  (texelFetch(moisture_source, below, 0) - moisture);
            }
            if (cell.y < levels - 1 && upper_inside)
            {
                ivec3 above = ivec3(cell.x, cell.y + 1, cell.z);
                float spacing = max(nest_level_altitude(float(cell.y) + 1.0) - altitude, 1.0);
                float coefficient = min(nest_face_diffusivity(upper_face, depth) * nest.dt /
                                            (spacing * thickness),
                                        0.25);
                delta_theta += coefficient * (total_theta(above) - theta_total);
                delta_moisture += coefficient *
                                  (texelFetch(moisture_source, above, 0) - moisture);
            }

            theta += delta_theta;
            moisture += delta_moisture;
        }
    }

    // Mixing ratios are non-negative by definition; the clamp above already bounds them by
    // upstream values, and this is the floor that survives a degenerate stencil.
    moisture = max(moisture, vec4(0.0));

    imageStore(theta_target, cell, vec4(theta, 0.0, 0.0, 0.0));
    imageStore(moisture_target, cell, moisture);
}
