#version 450
#extension GL_GOOGLE_include_directive : require

// One relaxation sweep of the anelastic pressure equation
//
//     div( rho_base * c_p * theta_base * grad(pi') )  =  div(rho_base * u*) / dt
//
// solved *exactly in the vertical* for a whole column at a time, and iterated in the
// horizontal by red-black colouring.
//
// **Why a vertical line solver rather than the FFT §6 names, or a plain point iteration.**
// The nest's grid is strongly anisotropic on purpose: ~2 km horizontally against ~54-560 m
// vertically. The Laplacian's vertical coupling therefore outweighs its horizontal coupling by
// (dx/dz)^2 -- upwards of two orders of magnitude near the ground. A point smoother (Jacobi,
// red-black Gauss-Seidel on the full stencil) propagates information one cell per sweep along
// the direction that matters and converges appallingly; a *line* solver inverts that direction
// in one shot, which is the textbook remedy for exactly this anisotropy. An FFT would need a
// Vulkan compute FFT written from scratch, which is a project of its own for no gain the line
// solver does not already deliver at this grid's aspect ratio.
//
// **How few sweeps this needs, measured rather than supposed.** With no coarse-grid correction
// the *smooth horizontal* component of the error decays slowly -- which is a real property of an
// isotropic Poisson problem and very nearly beside the point here. The anisotropy that motivates
// the line solver in the first place also makes what is left for the sweeps to do a small,
// strongly diagonally dominant correction: the horizontal coupling is 1/12 of the vertical at the
// domain top and 1/1370 of it at the ground, so the smooth mode the relaxation converges slowly
// on contributes proportionally little to the answer.
//
// Measured end-to-end over six simulated hours, at 2, 4, 8, 12 and 20 sweeps: surface humidity,
// lifting condensation level, cloud base, column water and sky coverage identical to every
// printed figure, and the peak divergence -- the quantity this solve exists to control -- equal
// to seven significant figures. At *one* sweep it is not, which is what tells convergence apart
// from a solve that was never doing anything. `pressure_iterations` defaults to 4 accordingly:
// twice the measured convergence point.
//
// Geometric multigrid over the horizontal (semi-coarsened, with this shader as its smoother)
// remains the refinement, and drops in without changing anything around it -- but the
// measurement says there is no residual for it to remove at this grid's aspect ratio. It becomes
// interesting if the domain is ever made closer to isotropic.
//
// Neumann conditions everywhere -- no flow through the ground or the lid, and the lateral
// boundary is a relaxation zone rather than a wall -- leave pi' defined only up to a constant.
// That is harmless: the projection uses its gradient and nothing else.

layout(local_size_x = 8, local_size_y = 8) in;

#include "atmosphere_nest_common.glsl"

layout(set = 0, binding = 1) uniform sampler3D divergence;
layout(set = 0, binding = 2, r32f) uniform image3D pressure;

layout(push_constant) uniform Params
{
    uint colour; // 0 = red cells this sweep, 1 = black
} push;

// The nest's vertical resolution ceiling, asserted against on the C++ side.
const int MAX_LEVELS = 64;

// **The tridiagonal matrix does not depend on the column, so neither does its factorization.**
//
// `lower`, `upper` and `diagonal` below are functions of the level index alone -- base-state
// density, potential temperature and the stretched grid's spacings, none of which vary
// horizontally. Only the right-hand side is a property of the column. So the Thomas
// elimination's pivots and c' factors are one table shared by every column in the workgroup,
// rather than recomputed per column into a 64-float private array.
//
// This is not an approximation; it is the same arithmetic hoisted out of a loop it never
// belonged in. Two things fall out of it, and the measurement confirms both: there is no private
// array, and so none of the local-memory spill a dynamically indexed 256-byte array per
// invocation forces on NVIDIA; and `nest_pressure_coefficient` -- a chain of `pow` and `exp`
// through the base-state pressure and Exner function -- is evaluated three times per *level*
// instead of three times per level per *column*, a factor of 64 at this workgroup size.
//
// What is given up, stated rather than hidden: with no coarse-grid correction the *smooth
// horizontal* component of the error decays slowly. Sharing the factorization changes the
// cost of a sweep and nothing about what a sweep computes.
shared float s_lower[MAX_LEVELS];      // sub-diagonal, level k to k - 1
shared float s_horizontal[MAX_LEVELS]; // the horizontal coefficient the neighbours enter through
shared float s_inverse_pivot[MAX_LEVELS];
shared float s_factor[MAX_LEVELS];     // c'_k = upper_k / pivot_k
shared float s_upper[MAX_LEVELS];
shared float s_diagonal[MAX_LEVELS];

// The elliptic operator's coefficient C = rho_base * c_p * theta_base at an altitude.
float nest_pressure_coefficient(float altitude)
{
    return nest_base_density(altitude) * nest.specific_heat_pressure * nest_base_theta(altitude);
}

void main()
{
    ivec2 column = ivec2(gl_GlobalInvocationID.xy);
    int levels = min(nest_level_count(), MAX_LEVELS);
    float inverse_dx2 = 1.0 / (nest.spacing * nest.spacing);
    float inverse_dt = 1.0 / max(nest.dt, 1e-4);

    // ---- The column-independent half, built once for the whole workgroup ------------------
    //
    // Every thread participates and no thread has returned yet: the bounds and colour tests are
    // deferred past the barriers below, because a barrier reached by only some invocations of a
    // workgroup is undefined behaviour and the colour test makes exactly half of them diverge.

    uint lane = gl_LocalInvocationIndex;
    if (lane < uint(levels))
    {
        int k = int(lane);
        float altitude = nest_level_altitude(float(k));
        float thickness = nest_level_thickness(k);

        // Vertical coefficients live on the faces so the discrete operator stays self-adjoint
        // -- the same reason the divergence is a sum of face fluxes.
        float coefficient = nest_pressure_coefficient(altitude);
        float coefficient_below = nest_pressure_coefficient(nest_face_altitude(float(k)));
        float coefficient_above = nest_pressure_coefficient(nest_face_altitude(float(k) + 1.0));

        // Centre-to-centre spacing is what a face-normal derivative divides by on a stretched
        // grid; at the boundaries the level's own thickness stands in and the coefficient is
        // zeroed anyway, which is the no-flow condition.
        float gap_below = k > 0 ? altitude - nest_level_altitude(float(k) - 1) : thickness;
        float gap_above = k < levels - 1 ? nest_level_altitude(float(k) + 1) - altitude
                                         : thickness;

        float lower = k > 0 ? coefficient_below / (gap_below * thickness) : 0.0;
        float upper = k < levels - 1 ? coefficient_above / (gap_above * thickness) : 0.0;
        float horizontal = coefficient * inverse_dx2;

        s_lower[k] = lower;
        s_upper[k] = upper;
        s_horizontal[k] = horizontal;
        s_diagonal[k] = -(lower + upper) - 4.0 * horizontal;
    }
    barrier();

    // The elimination is a sequential recurrence in k, so one lane walks it. Forty-eight
    // iterations of four multiplies, once per workgroup, against the 64 columns that would
    // otherwise each repeat it.
    if (lane == 0u)
    {
        float previous_factor = 0.0;
        for (int k = 0; k < levels; ++k)
        {
            // A collapsed pivot (a degenerate single-level domain) would divide by zero; the
            // floor keeps it finite, and the answer there is simply "no correction", which is
            // the right answer for a domain with nowhere to push mass.
            float pivot = k == 0 ? s_diagonal[0] : s_diagonal[k] - s_lower[k] * previous_factor;
            pivot = abs(pivot) > 1e-12 ? pivot : 1e-12;
            float inverse_pivot = 1.0 / pivot;
            s_inverse_pivot[k] = inverse_pivot;
            previous_factor = s_upper[k] * inverse_pivot;
            s_factor[k] = previous_factor;
        }
    }
    barrier();

    // ---- The column's own half -------------------------------------------------------------
    //
    // Red-black: neighbouring columns are updated in different sweeps, so a sweep never reads a
    // horizontal neighbour it is concurrently writing.
    if (column.x >= nest.cells_x || column.y >= nest.cells_z ||
        (uint(column.x + column.y) & 1u) != push.colour)
        return;

    float previous_solution = 0.0;
    for (int k = 0; k < levels; ++k)
    {
        ivec3 cell = ivec3(column.x, k, column.y);

        // Horizontal neighbours enter the right-hand side at their current values -- the
        // "line" part of line relaxation. They belong to the other colour, so this sweep is
        // never reading a column it is concurrently writing.
        float neighbours =
            imageLoad(pressure, nest_clamp(cell + ivec3(1, 0, 0))).r +
            imageLoad(pressure, nest_clamp(cell - ivec3(1, 0, 0))).r +
            imageLoad(pressure, nest_clamp(cell + ivec3(0, 0, 1))).r +
            imageLoad(pressure, nest_clamp(cell - ivec3(0, 0, 1))).r;
        float rhs =
            texelFetch(divergence, cell, 0).r * inverse_dt - s_horizontal[k] * neighbours;

        previous_solution =
            (rhs - (k == 0 ? 0.0 : s_lower[k] * previous_solution)) * s_inverse_pivot[k];

        // d' goes straight into the image rather than into a private array; the back
        // substitution reads it out again a moment later.
        imageStore(pressure, cell, vec4(previous_solution, 0.0, 0.0, 0.0));
    }

    // Back substitution, in place. `previous_solution` is already x at the top level, where d'
    // and x coincide.
    float above = previous_solution;
    for (int k = levels - 2; k >= 0; --k)
    {
        ivec3 cell = ivec3(column.x, k, column.y);
        float solution = imageLoad(pressure, cell).r - s_factor[k] * above;
        imageStore(pressure, cell, vec4(solution, 0.0, 0.0, 0.0));
        above = solution;
    }
}
