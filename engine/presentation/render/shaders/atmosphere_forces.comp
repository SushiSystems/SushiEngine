#version 450
#extension GL_GOOGLE_include_directive : require

// Everything that acts on the nest between transport and the pressure projection: buoyancy,
// Coriolis, subgrid diffusion, the Rayleigh sponge under the lid, the surface fluxes that
// drive convection, and the Davies relaxation that ties the lateral boundary to the parent
// solution.
//
// docs/slop/atmosphere_system.md §6's momentum and thermodynamic equations, minus the pressure
// gradient — that is the next two dispatches' job, and separating it is the whole point of a
// projection method: this shader produces a provisional velocity that is *not*
// divergence-free, and the pressure solve then removes exactly the part that is not.
//
// The buoyancy term is the one to read closely, because it is what the shipped system did not
// have at all (§1.3: "no vertical advection ... the three levels are independent 2-D fields"):
//
//     B = g · (theta_v' / theta_v_base  -  q_c  -  q_r)
//
// The first term is thermal buoyancy through the *virtual* potential temperature, so a parcel
// that is moist is lighter than a dry one at the same temperature; the last two are condensate
// loading, the weight of the water a cloud is carrying. Latent heat released by condensation
// raises theta', which raises B, which accelerates the updraft, which lifts more vapour to its
// condensation level — that closed loop is what makes a cumulus grow rather than merely exist,
// and it cannot be written down at all without a vertical velocity to feed it.

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

#include "atmosphere_nest_common.glsl"

layout(set = 0, binding = 1, r32f) uniform image3D wind_x;
layout(set = 0, binding = 2, r32f) uniform image3D wind_y;
layout(set = 0, binding = 3, r32f) uniform image3D wind_z;
layout(set = 0, binding = 4, r32f) uniform image3D theta;
layout(set = 0, binding = 5, rgba32f) uniform image3D moisture;
// The parent solution the boundary zone relaxes toward: rg = wind, b = theta anomaly,
// a = relative-humidity anomaly, addressed in world space by the map below.
layout(set = 0, binding = 6) uniform sampler2D forcing;
// The surface energy balance's output for this column: skin temperature (K), sensible flux,
// latent flux, net radiation (W/m²). Written one dispatch ago by atmosphere_surface.comp.
layout(set = 0, binding = 7, rgba32f) uniform readonly image2D surface_state;
// The parent's large-scale vertical motion, positive up, addressed by the same world-space map
// as `forcing`. Applied over the whole domain rather than the boundary zone -- see below.
layout(set = 0, binding = 8) uniform sampler2D forcing_vertical;

layout(push_constant) uniform Params
{
    // Camera-relative XZ metres of the nest's low corner, and the metres-to-forcing-UV map,
    // so a cell can ask the parent solution what it should be relaxing toward.
    vec2 origin_rel;
    vec2 forcing_scale;
    vec2 forcing_offset;
} push;

// Mixing ratios are carried in g/kg: fp16 holds 1e-3..20 comfortably, where kg/kg would put
// drizzle-scale rain into the denormal range and flush it to zero.
vec4 forcing_at(ivec3 cell)
{
    vec2 world = push.origin_rel + (vec2(cell.x, cell.z) + 0.5) * nest.spacing;
    return texture(forcing, world * push.forcing_scale + push.forcing_offset);
}

void main()
{
    ivec3 cell = ivec3(gl_GlobalInvocationID);
    if (cell.x >= nest.cells_x || cell.y >= nest_level_count() || cell.z >= nest.cells_z)
        return;

    int levels = nest_level_count();
    float altitude = nest_level_altitude(float(cell.y));
    float thickness = nest_level_thickness(cell.y);
    float base_theta = nest_base_theta(altitude);
    float base_density = nest_base_density(altitude);
    float dt = nest.dt;

    float theta_perturbation = imageLoad(theta, cell).r;
    vec4 q = imageLoad(moisture, cell) / MOISTURE_UNIT;

    // ---- Surface fluxes -------------------------------------------------------------
    //
    // **Read, not computed.** `atmosphere_surface.comp` ran one dispatch ago and solved this
    // column's energy balance; what is left here is the bookkeeping that turns a flux in W/m²
    // into a tendency, by the mass of air the lowest level actually contains.
    //
    // The diurnal shape, the surface heterogeneity and the night-time cooling are all decided
    // there rather than here, because all three are properties of the *ground* and none of them
    // is a property of the air. The reasoning is written up in that file; the short version is
    // that a prescribed flux cannot lag solar noon, cannot respond to the air it is heating, and
    // cannot change its Bowen ratio as the surface dries.
    if (cell.y == 0)
    {
        float mass = max(base_density * thickness, 1.0); // kg/m^2 of air in this level
        vec4 surface = imageLoad(surface_state, ivec2(cell.x, cell.z));
        float sensible = surface.g;
        float latent = surface.b;

        float heating = sensible / (nest.specific_heat_pressure * mass);
        theta_perturbation += heating * dt / max(nest_exner(altitude), 1e-6);

        // Negative at night, as the sensible flux is: dew and frost are the surface taking water
        // back out of the air, and clamping the vapour non-negative below is what keeps that from
        // running past empty.
        float moistening = latent / (nest.latent_heat_vaporization * mass);
        q.x += moistening * dt;
    }

    // ---- Rayleigh sponge -------------------------------------------------------------
    float sponge = nest_sponge_weight(altitude) * nest.sponge_rate * dt;
    if (sponge > 0.0)
        theta_perturbation -= theta_perturbation * min(sponge, 1.0);

    // ---- Davies lateral relaxation ----------------------------------------------------
    //
    // The nest is a window onto a larger atmosphere it does not simulate. Nudging the fields
    // toward the parent across a ramped zone — rather than injecting them at the edge — is
    // what keeps a front crossing the domain instead of reflecting off its boundary.
    float boundary = nest_boundary_weight(cell);
    if (boundary > 0.0)
    {
        vec4 parent = forcing_at(cell);
        float rate = min(nest.boundary_relaxation * boundary * dt, 1.0);
        // The parent's anomalies decay with height: a synoptic warm sector is a property of
        // the lower troposphere, not of the stratosphere above it.
        float depth = exp(-altitude / 6000.0);
        float target_theta = parent.b * depth;
        float saturation = nest_saturation_mixing_ratio(
            (base_theta + theta_perturbation) * nest_exner(altitude), nest_base_pressure(altitude));
        float target_vapour = clamp(nest_base_vapour(altitude) + parent.a * depth * saturation,
                                    0.0, saturation);
        theta_perturbation += (target_theta - theta_perturbation) * rate;
        q.x += (target_vapour - q.x) * rate;
    }

    // ---- Large-scale vertical motion ---------------------------------------------------
    //
    // **Not a boundary condition, and that is why it is outside the zone above.** A 384 km window
    // has no way to know it is sitting under a thousand-kilometre high, and the gentle descent
    // that produces is a real term in this air's budget: subsidence warms by compression and
    // dries by bringing down air from where there is less water. Every limited-area model
    // receives it from its parent, because the mechanism that sets it is larger than the domain.
    //
    // With no subsidence a saturated layer aloft has *no sink at all* overnight -- too thin to
    // rain, the mixed layer that fed it collapsed, nothing to mix it -- so an evening deck grows
    // until dawn instead of decaying. Horizontal advection is measured far too slow to stand in:
    // eight metres a second across 384 km is thirteen hours, against a night.
    //
    // Centimetres per second against a metre-per-second updraft, and it still matters, because
    // it acts over the whole domain for the whole day rather than over one cell for ten minutes.
    //
    // The profile: zero at the ground (nothing descends through it), rising to the supplied
    // value near the top of the boundary layer -- which is where Ekman pumping delivers it --
    // and decaying to zero at the tropopause. Applied to the scalars only; the momentum it also
    // advects is second-order beside the pressure gradient it comes with, and is left out.
    {
        vec2 world = push.origin_rel + (vec2(cell.x, cell.z) + 0.5) * nest.spacing;
        float large_scale = texture(forcing_vertical,
                                    world * push.forcing_scale + push.forcing_offset).r;
        if (large_scale != 0.0)
        {
            float ramp = max(nest.boundary_layer_depth, 1.0);
            float top = max(nest.tropopause_altitude, ramp + 1.0);
            float shape = altitude < ramp
                              ? altitude / ramp
                              : max(1.0 - (altitude - ramp) / (top - ramp), 0.0);
            float w_large = large_scale * shape;
            if (w_large != 0.0)
            {
                // Against the *total* potential temperature, because it is the total profile
                // that has the stability: the base state's own lapse is most of it, and taking
                // only the perturbation's gradient would leave subsidence warming nothing at all
                // in an undisturbed column -- which is precisely the column it has to dry.
                int above = min(cell.y + 1, levels - 1);
                int below = max(cell.y - 1, 0);
                float altitude_above = nest_level_altitude(float(above));
                float altitude_below = nest_level_altitude(float(below));
                float span = max(altitude_above - altitude_below, 1.0);

                float theta_up = nest_base_theta(altitude_above) +
                                 imageLoad(theta, ivec3(cell.x, above, cell.z)).r;
                float theta_down = nest_base_theta(altitude_below) +
                                   imageLoad(theta, ivec3(cell.x, below, cell.z)).r;
                theta_perturbation -= w_large * (theta_up - theta_down) / span * dt;

                float vapour_up =
                    imageLoad(moisture, ivec3(cell.x, above, cell.z)).x / MOISTURE_UNIT;
                float vapour_down =
                    imageLoad(moisture, ivec3(cell.x, below, cell.z)).x / MOISTURE_UNIT;
                q.x -= w_large * (vapour_up - vapour_down) / span * dt;
            }
        }
    }

    // ---- Cloud-top radiative cooling ---------------------------------------------------
    //
    // The sink a cloud has and the clear air beside it does not, and the reason a stratocumulus
    // deck mixes itself all night. A cloud top is optically thick in the longwave with space
    // above it, so it loses ~70 W/m² across a layer tens of metres deep; the flux is used up
    // going *down* into the cloud as exp(-kappa * liquid water path above), which concentrates
    // essentially all of the cooling in the top few tens of grams of water. That concentration is
    // the mechanism rather than an implementation detail: the same energy spread through the deck
    // would cool it stably, where cooling only its top makes the top denser than what is under it
    // and drives the overturning that entrains dry air down from above. The entrainment is
    // therefore *resolved* here rather than parameterized -- the nest has a vertical velocity, so
    // the term it needs is the one that makes the air want to sink, not a flux invented to stand
    // in for the sinking.
    //
    // Without this term the only sink a nocturnal deck has is the parent's subsidence (see the
    // block above), so a deck under a quiescent parent persists until dawn.
    //
    // Only cloudy cells pay for the column march, and the flux is exhausted within a few cloudy
    // levels, so what looks like an O(levels) loop costs a couple of iterations in the cells that
    // run it at all.
    if (q.y > 0.0 && nest.cloud_top_longwave_flux > 0.0)
    {
        float path = 0.0; // liquid water path above this cell, kg/m^2
        for (int above = cell.y + 1; above < levels; ++above)
        {
            float altitude_above = nest_level_altitude(float(above));
            vec4 q_above = imageLoad(moisture, ivec3(cell.x, above, cell.z)) / MOISTURE_UNIT;
            path += q_above.y * nest_base_density(altitude_above) * nest_level_thickness(above);
            // Past this the exponential is under half a percent and every level costs the same.
            if (nest.cloud_water_absorption * path > 6.0)
                break;
        }

        // **What the top is given depends on how cold it already is**, and without that this term
        // is a sink rather than a flux. The sky above a cloud top is not empty: it returns a share
        // of what the top emits, and that share grows as the top cools, until at
        // `cloud_top_equilibrium_depression` below its environment the two balance. Left as a
        // constant, a deck that persists pays the same 70 W/m² forever and nothing in this model
        // ever warms a cloud -- measured, a deck at 1585 m under a quiescent parent reached
        // **-42.7 K at 72 h**, still falling linearly, and took the ground 21 K down with it.
        // Exactly 1 at ambient, so a transient deck sees no change and only a runaway is capped.
        float departure = theta_perturbation * nest_exner(altitude);
        float closing = clamp(1.0 + departure /
                                        max(nest.cloud_top_equilibrium_depression, 1e-3),
                              0.0, 1.0);

        // The flux *difference across this cell*, not the local dF/dz. The distinction is not
        // pedantry: a 250 m level holding half a gram per kilogram is optically thick on its own
        // (kappa rho q_c dz is 16), so the differential form would cool it at 16 K/h where the
        // energy actually arriving is 1. Written as a difference of two exponentials, the column
        // telescopes to F0 (1 - exp(-kappa W_total)) and the scheme cannot radiate away more than
        // the cloud top is given, at any resolution.
        float own = q.y * base_density * thickness;
        float absorbed = nest.cloud_top_longwave_flux * closing *
                         (exp(-nest.cloud_water_absorption * path) -
                          exp(-nest.cloud_water_absorption * (path + own)));
        float cooling = absorbed / (nest.specific_heat_pressure * base_density * thickness);
        theta_perturbation -= cooling * dt / max(nest_exner(altitude), 1e-6);

        // ---- Cloud-top entrainment -----------------------------------------------------
        //
        // The other half of what the cooling above does, and the half that lets a deck *end*.
        // The overturning the radiative loss drives does not stop at the cloud top: it entrains
        // warm, dry air down across the inversion, which warms the top back toward its
        // environment and — the part that matters for the deck's lifetime — dries the layer
        // the cloud condenses from. Without it the deck's only bounds are the parent's
        // subsidence and the equilibrium depression above, and the depression is a floor a
        // persistent deck sits against rather than a balance it finds: measured, −13.9 K
        // against the 15 K parameter, indefinitely, with the condensate growing monotonically
        // and the diagnosed cloud fraction pinned at its clamp in 900 of 1024 mirror columns.
        //
        // The closure is the flux-partitioning form (Lilly 1968; Nicholls & Turton 1986):
        //
        //     w_e = A · ΔF / (ρ · c_p · Δθ)
        //
        // with ΔF the radiative flux this cell actually absorbs — so the entrainment carries
        // the same top-concentration and the same closing condition as the cooling that drives
        // it, and the two shut down together. Δθ is the inversion jump to the level above,
        // floored so a vanishing inversion asks for a mixing velocity the step can integrate.
        // The entrained fraction mixes theta (conserved across the mixing), vapour and cloud
        // water toward the level above; the evaporation of cloud water into the entrained dry
        // air is the microphysics dispatch's job one barrier later, which is where the
        // evaporative cooling lands without being double-counted here.
        //
        // Gated on a *stable* interface: an unstable one is ordinary convection, which the
        // resolved dynamics already handles, and entraining through it would double-count.
        if (nest.cloud_top_entrainment_efficiency > 0.0 && cell.y < levels - 1)
        {
            ivec3 above_cell = ivec3(cell.x, cell.y + 1, cell.z);
            float altitude_above = nest_level_altitude(float(cell.y + 1));
            float theta_above = nest_base_theta(altitude_above) +
                                imageLoad(theta, above_cell).r;
            float inversion = theta_above - (base_theta + theta_perturbation);
            if (inversion > 0.05)
            {
                vec4 q_above = imageLoad(moisture, above_cell) / MOISTURE_UNIT;
                float entrainment = nest.cloud_top_entrainment_efficiency * absorbed /
                                    (base_density * nest.specific_heat_pressure *
                                     max(inversion, 0.5));
                // The fraction of this cell replaced by inversion air this step, capped for
                // stability at long steps the same way the diffusion below is.
                float mixed = min(entrainment * dt / max(thickness, 1.0), 0.25);
                theta_perturbation += mixed * inversion;
                q.x += mixed * (q_above.x - q.x);
                q.y += mixed * (q_above.y - q.y);
            }
        }
    }

    // ---- Buoyancy, Coriolis, diffusion on the momentum --------------------------------
    //
    // Buoyancy lands on the vertical face this cell owns, from the average of the two cells
    // that face separates — the staggered arrangement's own definition of "the buoyancy the
    // face feels".
    float u = imageLoad(wind_x, cell).r;
    float w = imageLoad(wind_y, cell).r;
    float v = imageLoad(wind_z, cell).r;

    if (cell.y > 0 && cell.y < levels - 1)
    {
        ivec3 below = ivec3(cell.x, cell.y - 1, cell.z);
        float theta_below = imageLoad(theta, below).r;
        vec4 q_below = imageLoad(moisture, below) / MOISTURE_UNIT;
        float face_altitude = nest_face_altitude(float(cell.y));
        float face_base_theta = nest_base_theta(face_altitude);

        float theta_face = 0.5 * (theta_perturbation + theta_below);
        // The **departure** from the base state's own vapour, not the total. `theta` is stored
        // as a perturbation and `moisture` is not (see MOISTURE_UNIT's note), so taking the
        // moisture at face value here would quietly make this a different equation from the one
        // at the top of this file: the prime on theta_v' has to cover the vapour term too.
        //
        // What that costs. g * 0.61 * q_v is 0.043 m/s^2 for a 7 g/kg surface layer, against
        // 0.0068 m/s^2 for a 0.2 K thermal — the spurious part is **six times the signal**.
        // Being horizontally near-uniform it drives no updraft of its own; the pressure solve
        // cancels it, since that is precisely what a projection does to a term that is already
        // in hydrostatic balance. But the solve is a fixed number of relaxation sweeps, so what
        // it leaves behind scales with what it was asked to remove, and the convection this
        // model exists to produce would run underneath a six-fold larger residual.
        float vapour_face = 0.5 * (q.x + q_below.x) - nest_base_vapour(face_altitude);
        float condensate_face = 0.5 * (q.y + q.z + q_below.y + q_below.z);

        // Virtual potential temperature: vapour is lighter than dry air by the ratio of their
        // gas constants, so 0.61 kg of vapour per kg of dry air buoys like a degree of warmth.
        const float VIRTUAL_COEFFICIENT = 0.61;
        float theta_virtual = theta_face + face_base_theta * VIRTUAL_COEFFICIENT * vapour_face;
        float buoyancy = nest.gravity * (theta_virtual / max(face_base_theta, 1.0) -
                                         condensate_face);
        w += buoyancy * dt;
        // The sponge damps momentum too, and this is the term it exists for: without it the
        // gravity waves an updraft radiates reflect off the lid back into the storm.
        w -= w * min(nest_sponge_weight(face_altitude) * nest.sponge_rate * dt, 1.0);
    }
    else
    {
        w = 0.0; // rigid ground and lid
    }

    // Coriolis, evaluated at the nest centre (the domain is a few hundred kilometres across,
    // so f's own variation over it is below what this grid resolves). Applied as a rotation
    // rather than an explicit cross product so it neither gains nor loses kinetic energy at
    // long time steps, which the explicit form does.
    float angle = nest.coriolis * dt;
    float cos_f = cos(angle);
    float sin_f = sin(angle);
    float rotated_u = u * cos_f + v * sin_f;
    float rotated_v = -u * sin_f + v * cos_f;
    u = rotated_u;
    v = rotated_v;

    // Subgrid diffusion, explicit and horizontal-only: the vertical spacing is small enough
    // that an explicit vertical diffusion would set the time step instead of advection doing
    // it, and the mixing that matters at this resolution is the horizontal exchange between
    // an updraft and the air it entrains.
    float diffusion = nest.eddy_viscosity * dt / (nest.spacing * nest.spacing);
    if (diffusion > 0.0)
    {
        diffusion = min(diffusion, 0.2); // explicit stability, whatever the authored viscosity
        float laplacian_theta =
            imageLoad(theta, nest_clamp(cell + ivec3(1, 0, 0))).r +
            imageLoad(theta, nest_clamp(cell - ivec3(1, 0, 0))).r +
            imageLoad(theta, nest_clamp(cell + ivec3(0, 0, 1))).r +
            imageLoad(theta, nest_clamp(cell - ivec3(0, 0, 1))).r - 4.0 * theta_perturbation;
        theta_perturbation += diffusion * laplacian_theta;
    }

    imageStore(wind_x, cell, vec4(u, 0.0, 0.0, 0.0));
    imageStore(wind_y, cell, vec4(w, 0.0, 0.0, 0.0));
    imageStore(wind_z, cell, vec4(v, 0.0, 0.0, 0.0));
    imageStore(theta, cell, vec4(theta_perturbation, 0.0, 0.0, 0.0));
    imageStore(moisture, cell, max(q, vec4(0.0)) * MOISTURE_UNIT);
}
