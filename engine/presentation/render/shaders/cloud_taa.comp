#version 450

// CloudTAAPass (W3): the cloud buffer's own dedicated temporal resolve, War Thunder's
// shipped scheme per the design doc — YCoCg neighbourhood variance clip (gamma ~= 1.2),
// motion vectors sourced from the existing velocity target where opaque geometry is
// visible and a view-ray reprojection fallback where it is not (the common case: most
// of a cloud pixel's neighbourhood is sky), and history acceptance boosted under
// sub-pixel motion. Runs entirely before CloudCompositePass folds the resolved cloud
// over the sky, and long before the frame's own taa_pass_, which only ever sees the
// already-composited result as an ordinary shaded pixel.
//
// Simplifications versus the main resolve (taa.frag), named rather than silent: bilinear
// reconstruction instead of a bicubic Catmull-Rom tap (the cloud buffer's own content is
// already soft/volumetric, so the sharpening a bicubic tap buys the crisp main scene
// resolve matters far less here), and a single point-sampled velocity/depth read instead
// of a 3x3 dilation neighbourhood (this target is already coarser than the full-res
// velocity/depth buffers it reads, so one tap already covers roughly the footprint a
// full-res dilation would).

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D out_color;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D out_weight;
layout(set = 0, binding = 2) uniform sampler2D history_color;
layout(set = 0, binding = 3) uniform sampler2D history_weight;
layout(set = 0, binding = 4) uniform sampler2D cloud_color;
layout(set = 0, binding = 5) uniform sampler2D velocity_texture;
layout(set = 0, binding = 6) uniform sampler2D depth_texture;
// CloudPass's W3 MRT sibling on the same half-resolution grid as cloud_color: the
// march's transmittance-weighted mean depth in metres along the view ray, 0 where the
// march early-outed. The reprojection fallback below anchors the history lookup at this
// range, which is what lets camera *translation* produce parallax on the deck instead
// of the deck riding the screen.
layout(set = 0, binding = 9) uniform sampler2D cloud_depth_texture;

// Truncated prefix of the shared scene block (see temporal_common.glsl's header comment
// for the convention): this pass only needs the camera basis for the sky/cloud
// reprojection fallback, so it stops there rather than mirroring the whole struct the
// way a pass with a shared push-descriptor set binding is forced to.
layout(set = 0, binding = 7) uniform SceneBlock
{
    mat4 view;
    mat4 proj;
    vec4 cam_forward;
    vec4 cam_right;
    vec4 cam_up;
} scene;

// Truncated prefix of the shared temporal block, for the same reason — extended through
// eye_delta, which the reprojection fallback needs (offsets are positional, so reaching
// it means naming everything before it).
layout(set = 0, binding = 8) uniform TemporalBlock
{
    mat4 previous_view_projection;
    vec4 jitter;      // xy = this frame's NDC jitter, zw = the previous frame's
    vec4 resolution;  // unused here
    vec4 blend;       // unused here
    vec4 thresholds;  // unused here
    vec4 eye_delta;   // xyz = this frame's eye minus last frame's, metres
} temporal;

layout(push_constant) uniform Push
{
    uint history_valid;  // 0 on the first bake or right after clouds were re-enabled
    // QualityParams::cloud_variance_clip. Selects *which* neighbourhood rejection runs, not
    // whether one does: 1 = the 9-tap YCoCg variance clip, 0 = the cheap 5-tap cross min/max
    // clamp. There is no setting that blends history unrejected — see the note at the clip.
    uint variance_clip;
} push;

// Standing in for design doc's gamma ~= 1.2 alongside the ordinary sigma-width clip: a
// slightly wider box than taa.frag's own CLIP_SIGMA, since this resolve has only one
// point-sampled current-frame tap per neighbour rather than a bicubic reconstruction and
// so needs a little more slack before it starts rejecting legitimate variation.
const float CLIP_SIGMA = 1.25;
const float CLIP_GAMMA = 1.2;
// Frames of accepted history before the feedback curve reaches its ceiling.
const float WEIGHT_RAMP_FRAMES = 16.0;
const float WEIGHT_MAX = 32.0;

vec3 rgb_to_ycocg(vec3 c)
{
    return vec3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b, 0.5 * c.r - 0.5 * c.b,
               -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
}

vec3 ycocg_to_rgb(vec3 c)
{
    float t = c.x - c.z;
    return vec3(t + c.y, c.x + c.z, t - c.y);
}

vec2 clip_to_uv(vec4 clip)
{
    return clip.xy / clip.w * 0.5 + 0.5;
}

void main()
{
    ivec2 size = imageSize(out_color);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec2 texel = 1.0 / vec2(size);
    vec2 uv = (vec2(pixel) + 0.5) * texel;

    vec4 current = max(texture(cloud_color, uv), vec4(0.0));

    // Reverse-Z: zero means nothing opaque was drawn here, the common case for a cloud
    // pixel sitting over open sky. There the surface velocity buffer carries nothing
    // meaningful, so the history is reprojected through the camera itself — and at the
    // march's own mean depth, not at infinity. A direction-at-infinity reprojection is
    // exact under rotation but blind to translation, and a deck one to three kilometres
    // away has real parallax: flying past it with the infinite fallback kept the history
    // glued to the same screen position, and the accumulation (feedback up to 0.97)
    // smeared the deck across the sky faster than the variance clip could claw it back.
    // Anchoring the reprojected point at the marched range restates it relative to last
    // frame's eye (the eye_delta offset — the matrix itself is translation-free), so
    // both rotation and translation land the history where the cloud actually was.
    float depth_here = texture(depth_texture, uv).r;
    vec2 velocity;
    if (depth_here > 0.0)
    {
        velocity = texture(velocity_texture, uv).rg;
    }
    else
    {
        vec2 ndc = uv * 2.0 - 1.0;
        vec3 ray = normalize(scene.cam_forward.xyz + ndc.x * scene.cam_right.xyz +
                             ndc.y * scene.cam_up.xyz);
        float range = texture(cloud_depth_texture, uv).r;
        // 0 is the march's own early-out (no shell hit, clouds off): nothing at a finite
        // range to anchor to, so the direction at infinity is the honest reprojection.
        vec4 previous_clip =
            range > 0.0
                ? temporal.previous_view_projection *
                      vec4(ray * range + temporal.eye_delta.xyz, 1.0)
                : temporal.previous_view_projection * vec4(ray, 0.0);
        velocity = previous_clip.w > 0.0 ? uv - clip_to_uv(previous_clip) : vec2(0.0);
    }

    vec2 history_uv = uv - velocity;
    bool history_inside = all(greaterThanEqual(history_uv, vec2(0.0))) &&
                          all(lessThanEqual(history_uv, vec2(1.0)));

    if (push.history_valid == 0u || !history_inside)
    {
        imageStore(out_color, pixel, current);
        imageStore(out_weight, pixel, vec4(1.0));
        return;
    }

    vec4 history = max(texture(history_color, history_uv), vec4(0.0));
    float weight = texture(history_weight, history_uv).r;

    vec3 current_ycocg = rgb_to_ycocg(current.rgb);
    vec3 history_ycocg = rgb_to_ycocg(history.rgb);

    // ---- Neighbourhood rejection ---------------------------------------------------------
    //
    // Not optional at any tier. `variance_clip` used to switch this block off entirely on Low,
    // leaving a plain EMA — and the clip is the *only* mechanism in this resolve that ever
    // removes a stale sample from the history. Without it a reprojection error does not decay,
    // it compounds: every frame folds up to 97 % of the previous answer forward, so a deck the
    // camera has moved past persists for ~33 frames. That is the reported trail, and it is why
    // it appeared under motion and nowhere else. Switching rejection off does not buy a
    // cheaper, softer resolve; it buys a wrong one, in the most visible way available.
    //
    // The tier knob therefore now selects *which* rejection rather than *whether*: the 9-tap
    // YCoCg variance clip above the cheap floor, and a 5-tap cross min/max clamp on it. The
    // cross costs four taps of a texture already resident and bounds the history by the
    // extremes actually present around the pixel, which is all that is needed to stop
    // accumulation. Having no distribution model to widen it, it clips harder than the
    // variance box — so the cheap tier trades a little temporal stability for a resolve that
    // cannot smear, which is the right side of that trade to be on.
    //
    // **Alpha is clamped alongside the colour, in both paths.** It was previously blended with
    // no rejection at all under either setting. This buffer's alpha is the march's
    // transmittance and CloudCompositePass folds the sky through it, so an unbounded alpha
    // history leaves a stale *silhouette* — a cloud-shaped hole in the sky with correctly
    // resolved colour inside it. Clipping the colour alone would have fixed the trail's hue
    // and left its shape.
    float history_alpha = history.a;
    if (push.variance_clip != 0u)
    {
        vec3 moment1 = vec3(0.0);
        vec3 moment2 = vec3(0.0);
        float alpha_min = current.a;
        float alpha_max = current.a;
        for (int y = -1; y <= 1; ++y)
        {
            for (int x = -1; x <= 1; ++x)
            {
                vec2 tap_uv = clamp(uv + vec2(x, y) * texel, vec2(0.0), vec2(1.0));
                vec4 tap_rgba = max(texture(cloud_color, tap_uv), vec4(0.0));
                vec3 tap = rgb_to_ycocg(tap_rgba.rgb);
                moment1 += tap;
                moment2 += tap * tap;
                alpha_min = min(alpha_min, tap_rgba.a);
                alpha_max = max(alpha_max, tap_rgba.a);
            }
        }
        const float SAMPLE_COUNT = 9.0;
        vec3 mean = moment1 / SAMPLE_COUNT;
        vec3 variance = max(moment2 / SAMPLE_COUNT - mean * mean, vec3(0.0));
        vec3 extent = sqrt(variance) * CLIP_SIGMA * CLIP_GAMMA;

        vec3 offset = history_ycocg - mean;
        vec3 unit = offset / max(extent, vec3(1e-5));
        vec3 magnitude = abs(unit);
        float largest = max(magnitude.x, max(magnitude.y, magnitude.z));
        history_ycocg = largest > 1.0 ? mean + offset / largest : history_ycocg;
        history_alpha = clamp(history_alpha, alpha_min, alpha_max);
    }
    else
    {
        // The cheap floor's rejection: a cross rather than the full 3x3, since the diagonals
        // add a third of the taps for the least new information about the local extremes.
        vec3 box_min = current_ycocg;
        vec3 box_max = current_ycocg;
        float alpha_min = current.a;
        float alpha_max = current.a;
        // Written as four indexed steps off a single offset rather than a local const array,
        // matching the rest of this shader set's avoidance of constructs that have historically
        // needed per-driver goodwill. The compiler unrolls it either way.
        for (int i = 0; i < 4; ++i)
        {
            vec2 offset = i == 0 ? vec2(-1.0, 0.0)
                        : i == 1 ? vec2(1.0, 0.0)
                        : i == 2 ? vec2(0.0, -1.0)
                                 : vec2(0.0, 1.0);
            vec2 tap_uv = clamp(uv + offset * texel, vec2(0.0), vec2(1.0));
            vec4 tap_rgba = max(texture(cloud_color, tap_uv), vec4(0.0));
            vec3 tap = rgb_to_ycocg(tap_rgba.rgb);
            box_min = min(box_min, tap);
            box_max = max(box_max, tap);
            alpha_min = min(alpha_min, tap_rgba.a);
            alpha_max = max(alpha_max, tap_rgba.a);
        }
        history_ycocg = clamp(history_ycocg, box_min, box_max);
        history_alpha = clamp(history_alpha, alpha_min, alpha_max);
    }

    // History acceptance boosted under sub-pixel motion: a reprojection displacing less
    // than a texel is close to exact, which the ramp below (built for the ordinary
    // disocclusion-recovery case) would otherwise still discount the same as any other
    // accepted sample.
    float speed_px = length(velocity * vec2(size));
    float sub_pixel_boost = speed_px < 1.0 ? 0.15 : 0.0;

    float new_weight = min(weight + 1.0, WEIGHT_MAX);
    float ramp = clamp(new_weight / WEIGHT_RAMP_FRAMES, 0.0, 1.0);
    float feedback = clamp(mix(0.1, 0.94, ramp) + sub_pixel_boost, 0.0, 0.97);

    vec3 resolved_ycocg = mix(current_ycocg, history_ycocg, feedback);
    vec3 resolved = max(ycocg_to_rgb(resolved_ycocg), vec3(0.0));
    float resolved_alpha = mix(current.a, history_alpha, feedback);

    imageStore(out_color, pixel, vec4(resolved, resolved_alpha));
    imageStore(out_weight, pixel, vec4(new_weight));
}
